// Phase 3 web example: start a bounded local HTTP service and call it.

import Flow.Async exposing (..)
import Flow.Http exposing (..)

fn handler(req) with Async {
    ok("hello from " + req.path)
}

fn server() -> Unit with Async, AsyncFail {
    let h = serve("127.0.0.1", 24901, handler)
    let _wait = sleep(250)
    shutdown(h)
}

fn client() -> String with Async, AsyncFail {
    let _wait = sleep(50)
    let resp = get("http://127.0.0.1:24901/phase3")
    resp.body
}

fn body() -> String with Async, AsyncFail {
    let pair = both(server, client)
    pair.1
}

fn main() with IO {
    print(run_async(body))
}
