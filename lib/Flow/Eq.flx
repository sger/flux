/// Equality.
///
/// `==` and `!=` desugar to `eq` and `neq`, so every type compared with an
/// operator is compared through this class. On a concrete primitive the
/// compiler lowers the operator straight to a primop, which is what lets the
/// instances below define `eq` as `x == y` without recursing.
///
/// The container instances carry a context — `Eq<a> => Eq<List<a>>` — so the
/// element type is a rigid variable inside the body and `==` cannot be applied
/// to it. They recurse through `eq` instead, routing each element through the
/// dictionary the constructor is handed. (Proposal 0179 Stage 7 and Stage 8.)
///
/// Until context reduction landed these went through constrained helper
/// functions (`list_eq`, `option_eq`) rather than recursing directly: a
/// predicate over the instance's own head was generalized into a second
/// dictionary parameter, so `neq(xs, ys) { !eq(xs, ys) }` failed on arity.
/// See docs/known_issues.md#ki-078.
module Flow.Eq {
    public class Eq<a> {
        fn eq(x: a, y: a) -> Bool
        fn neq(x: a, y: a) -> Bool
    }

    public instance Eq<Int> {
        fn eq(x, y) { x == y }
        fn neq(x, y) { x != y }
    }

    public instance Eq<Float> {
        fn eq(x, y) { x == y }
        fn neq(x, y) { x != y }
    }

    public instance Eq<String> {
        fn eq(x, y) { x == y }
        fn neq(x, y) { x != y }
    }

    public instance Eq<Bool> {
        fn eq(x, y) { x == y }
        fn neq(x, y) { x != y }
    }

    public instance Eq<a> => Eq<List<a>> {
        fn eq(xs, ys) {
            match xs {
                [h1 | t1] -> match ys {
                    [h2 | t2] -> eq(h1, h2) && eq(t1, t2),
                    _ -> false
                },
                _ -> match ys {
                    [h | t] -> false,
                    _ -> true
                }
            }
        }
        fn neq(xs, ys) { !eq(xs, ys) }
    }

    public instance Eq<a> => Eq<Option<a>> {
        fn eq(x, y) {
            match x {
                Some(u) -> match y {
                    Some(v) -> eq(u, v),
                    _ -> false
                },
                _ -> match y {
                    Some(v) -> false,
                    _ -> true
                }
            }
        }
        fn neq(x, y) { !eq(x, y) }
    }
}
