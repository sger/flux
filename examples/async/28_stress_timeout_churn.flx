// 28 — stress: timeout churn (every body cancelled exactly once)
//
// Every leaf wraps a 2s sleeper in a 5ms `timeout`, so each one times out and
// its body must be cancelled. A depth-9 tree runs 512 timeouts concurrently
// across 8 workers. Each timed-out leaf contributes 1 (the `None` arm).
//
// Invariant: the total is exactly 512. A body that leaked past its timeout, or
// a timeout that double-counted, would shift the total off 512 — and a stuck
// cancellation would make the program take 2s instead of milliseconds.
//
// Stress both backends with the migration/stealing knobs on:
//
//   FLUX_FIBER_MIGRATION=1 FLUX_WORK_STEALING=1 \
//     cargo run -- examples/async/28_stress_timeout_churn.flx                 # VM
//   FLUX_FIBER_MIGRATION=1 FLUX_WORK_STEALING=1 \
//     cargo run --features llvm -- examples/async/28_stress_timeout_churn.flx # native

// parity-expected-stdout-begin
// "timed out = 512"
// parity-expected-stdout-end

import Flow.Async exposing (..)

fn sleeper() -> Int with Async {
    sleep(2000)   // far longer than the 5ms bound — always times out
    99
}

fn leaf() -> Int with Async {
    match timeout(5, sleeper) {
        Some(_) -> 0,   // would mean the body beat its own timeout (never)
        None -> 1       // timed out as expected — body cancelled
    }
}

fn tree(depth: Int) -> Int with Async {
    if depth == 0 {
        leaf()
    } else {
        let p = both(fn() { tree(depth - 1) }, fn() { tree(depth - 1) })
        p.0 + p.1
    }
}

fn body() -> Int with Async {
    tree(9)
}

fn main() with IO {
    print("timed out = " + to_string(run_async_with_workers(8, body)))
}
