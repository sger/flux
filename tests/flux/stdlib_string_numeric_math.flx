// Tests for Flow.String, Flow.Numeric, and Flow.Math.
//
// These three are grouped because each is a thin layer over primops with a
// small surface. What is worth asserting is the boundaries: empty strings,
// slice indices at and past the end, division and modulo with negative
// operands (where languages disagree), and the float functions at the values
// where they are exactly defined.

import Flow.String as Str
import Flow.Numeric as Num
import Flow.Math as Math
import Flow.Array as Array

// ── Flow.String ────────────────────────────────────────────────

fn test_string_len_counts_characters() {
    assert_eq(Str.string_len("hello"), 5)
    assert_eq(Str.string_len(""), 0)
}

fn test_string_concat_joins() {
    assert_eq(Str.string_concat("ab", "cd"), "abcd")
    assert_eq(Str.string_concat("", "x"), "x")
    assert_eq(Str.string_concat("x", ""), "x")
}

fn test_string_slice_is_half_open() {
    assert_eq(Str.string_slice("hello", 0, 2), "he")
    assert_eq(Str.string_slice("hello", 1, 4), "ell")
}

fn test_an_empty_slice_is_the_empty_string() {
    assert_eq(Str.string_slice("hello", 2, 2), "")
}

fn test_a_slice_to_the_end_takes_the_remainder() {
    assert_eq(Str.string_slice("hello", 3, 5), "lo")
}

fn test_starts_with_and_ends_with() {
    assert_true(Str.starts_with("hello", "he"))
    assert_false(Str.starts_with("hello", "lo"))
    assert_true(Str.ends_with("hello", "lo"))
    assert_false(Str.ends_with("hello", "he"))
}

/// Every string starts with and ends with the empty string, and with itself.
fn test_the_empty_prefix_and_whole_string_always_match() {
    assert_true(Str.starts_with("hello", ""))
    assert_true(Str.ends_with("hello", ""))
    assert_true(Str.starts_with("hello", "hello"))
    assert_true(Str.ends_with("hello", "hello"))
}

/// A prefix longer than the string cannot match.
fn test_an_over_long_prefix_does_not_match() {
    assert_false(Str.starts_with("hi", "hiya"))
    assert_false(Str.ends_with("hi", "ahi"))
}

fn test_str_contains_finds_substrings() {
    assert_true(Str.str_contains("hello world", "o w"))
    assert_true(Str.str_contains("hello", "hello"))
    assert_false(Str.str_contains("hello", "xyz"))
}

fn test_every_string_contains_the_empty_string() {
    assert_true(Str.str_contains("hello", ""))
    assert_true(Str.str_contains("", ""))
}

fn test_chars_explodes_into_single_character_strings() {
    assert_eq(Str.chars("abc"), [|"a", "b", "c"|])
    assert_eq(Str.chars(""), [||])
}

fn test_join_inserts_a_separator_between_elements() {
    assert_eq(Str.join([|"a", "b", "c"|], "-"), "a-b-c")
}

/// No separator appears when there is nothing to separate.
fn test_join_on_short_arrays() {
    assert_eq(Str.join([|"solo"|], "-"), "solo")
    assert_eq(Str.join([||], "-"), "")
}

fn test_join_with_an_empty_separator_concatenates() {
    assert_eq(Str.join([|"a", "b"|], ""), "ab")
}

/// chars then join is a round trip.
fn test_chars_and_join_round_trip() {
    assert_eq(Str.join(Str.chars("hello"), ""), "hello")
}

// ── Flow.Numeric ───────────────────────────────────────────────

fn test_even_and_odd_are_complements() {
    assert_true(Num.even(4))
    assert_false(Num.odd(4))
    assert_true(Num.odd(3))
    assert_false(Num.even(3))
}

fn test_zero_is_even() {
    assert_true(Num.even(0))
    assert_false(Num.odd(0))
}

/// Parity is sign-independent.
fn test_negative_numbers_have_the_expected_parity() {
    assert_true(Num.even(-4))
    assert_true(Num.odd(-3))
}

fn test_gcd_of_two_positives() {
    assert_eq(Num.gcd(12, 18), 6)
    assert_eq(Num.gcd(17, 5), 1)
}

/// gcd(n, 0) is n — the identity that makes the Euclidean algorithm terminate.
fn test_gcd_with_zero_returns_the_other_operand() {
    assert_eq(Num.gcd(7, 0), 7)
    assert_eq(Num.gcd(0, 7), 7)
}

fn test_gcd_is_commutative() {
    assert_eq(Num.gcd(12, 18), Num.gcd(18, 12))
}

fn test_lcm_of_two_positives() {
    assert_eq(Num.lcm(4, 6), 12)
    assert_eq(Num.lcm(3, 5), 15)
}

/// lcm with zero is zero, since zero is a multiple of everything.
fn test_lcm_with_zero_is_zero() {
    assert_eq(Num.lcm(0, 5), 0)
}

fn test_signum_reports_the_sign() {
    assert_eq(Num.signum(42), 1)
    assert_eq(Num.signum(-42), -1)
    assert_eq(Num.signum(0), 0)
}

fn test_div_and_mod_on_positives() {
    assert_eq(Num.div(7, 2), 3)
    assert_eq(Num.mod(7, 2), 1)
}

/// The division identity must hold: div(a,b) * b + mod(a,b) == a.
fn test_div_and_mod_satisfy_the_division_identity() {
    assert_eq(Num.div(7, 2) * 2 + Num.mod(7, 2), 7)
    assert_eq(Num.div(20, 6) * 6 + Num.mod(20, 6), 20)
}

fn test_dividing_by_one_is_the_identity() {
    assert_eq(Num.div(9, 1), 9)
    assert_eq(Num.mod(9, 1), 0)
}

// `from_integral` / `real_to_frac` are deliberately not exported yet: Flux
// has no Int → Float conversion primop. See the note in lib/Flow/Numeric.flx.

// ── Flow.Math ──────────────────────────────────────────────────

fn test_sqrt_of_perfect_squares() {
    assert_eq(Math.sqrt(4.0), 2.0)
    assert_eq(Math.sqrt(9.0), 3.0)
    assert_eq(Math.sqrt(0.0), 0.0)
}

fn test_sqrt_of_one_is_one() {
    assert_eq(Math.sqrt(1.0), 1.0)
}

/// exp(0) and log(1) are the two values these are exactly defined at, so they
/// can be asserted without a tolerance.
fn test_exp_and_log_at_their_exact_points() {
    assert_eq(Math.exp(0.0), 1.0)
    assert_eq(Math.log(1.0), 0.0)
}

fn test_trig_at_zero() {
    assert_eq(Math.sin(0.0), 0.0)
    assert_eq(Math.cos(0.0), 1.0)
    assert_eq(Math.tan(0.0), 0.0)
}

fn test_inverse_trig_at_zero_and_one() {
    assert_eq(Math.asin(0.0), 0.0)
    assert_eq(Math.acos(1.0), 0.0)
    assert_eq(Math.atan(0.0), 0.0)
}

fn test_hyperbolic_at_zero() {
    assert_eq(Math.sinh(0.0), 0.0)
    assert_eq(Math.cosh(0.0), 1.0)
    assert_eq(Math.tanh(0.0), 0.0)
}

fn test_floor_and_ceil_on_positives() {
    assert_eq(Math.floor(2.7), 2.0)
    assert_eq(Math.ceil(2.1), 3.0)
}

/// Floor goes toward negative infinity, ceil toward positive — they are not
/// "round down/up in magnitude", which is where sign bugs come from.
fn test_floor_and_ceil_on_negatives_go_toward_infinity() {
    assert_eq(Math.floor(-2.1), -3.0)
    assert_eq(Math.ceil(-2.7), -2.0)
}

fn test_floor_and_ceil_are_identities_on_whole_numbers() {
    assert_eq(Math.floor(3.0), 3.0)
    assert_eq(Math.ceil(3.0), 3.0)
}

fn test_round_goes_to_the_nearest() {
    assert_eq(Math.round(2.4), 2.0)
    assert_eq(Math.round(2.6), 3.0)
}

/// Truncate drops the fraction toward zero, which differs from floor on
/// negatives — the classic pairing to get wrong.
fn test_truncate_goes_toward_zero_unlike_floor() {
    assert_eq(Math.truncate(2.7), 2.0)
    assert_eq(Math.truncate(-2.7), -2.0)
    assert_eq(Math.floor(-2.7), -3.0)
}

// ── composition ────────────────────────────────────────────────

/// The numeric helpers compose with the collection combinators like anything
/// else — nothing about them is special-cased.
fn test_numeric_predicates_compose_with_list_combinators() {
    let evens = filter([1, 2, 3, 4, 5, 6], Num.even)
    assert_eq(evens, [2, 4, 6])
    assert_eq(len(filter([1, 2, 3, 4, 5, 6], Num.odd)), 3)
}

fn test_a_string_pipeline() {
    let shout = "hello" |> upper
    assert_eq(shout, "HELLO")
    assert_true(Str.starts_with(shout, "HE"))
}
