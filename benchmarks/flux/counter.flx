// Koka's counter (test/bench/koka/counter.kk): a state handler holds a
// value counted down to 0, and the loop counts its own steps beside it,
// so it prints the starting value. Each turn performs twice, and every
// clause resumes as its last act.
import Flow.Env as Env
import Flow.Array as Array

effect State {
    get : () -> Int
    set : (Int) -> ()
}

fn counter(c: Int) -> Int with State {
    let i = perform State.get()
    if i == 0 { c } else {
        perform State.set(i - 1)
        counter(c + 1)
    }
}

fn run(n: Int) -> Int {
    counter(0) handle State(n) {
        get(resume, s) -> resume(s, s),
        set(resume, x, s) -> resume((), x)
    }
}

// The workload size: the program's first argument, or the size the suite
// was written with. `cargo xtask bench` passes a smaller one to the VM.
fn size(default: Int) -> Int with Env {
    match Array.get(Env.args(), 1) {
        Some(s) -> parse_int(s),
        None -> default,
    }
}

fn main() with IO {
    print(run(size(100100100)))
}
