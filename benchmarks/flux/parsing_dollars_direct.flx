// parsing_dollars without effects: the next char is made from the two
// counters where it is needed, and the parser's count and the sum are
// arguments. The same chars are read and dispatched on.
import Flow.Env as Env
import Flow.Array as Array

fn feed(n: Int, i: Int, j: Int, a: Int, s: Int) -> Int {
    if i > n { s } else {
        if j == 0 { parse(n, i + 1, i + 1, 10, a, s) } else { parse(n, i, j - 1, 36, a, s) }
    }
}

fn parse(n: Int, i: Int, j: Int, c: Int, a: Int, s: Int) -> Int {
    if c == 36 { feed(n, i, j, a + 1, s) } else {
        if c == 10 { feed(n, i, j, 0, s + a) } else { s }
    }
}

// The workload size: the program's first argument, or the size the suite
// was written with. `cargo xtask bench` passes a smaller one to the VM.
fn size(default: Int) -> Int with Env {
    match Array.get(Env.args(), 1) {
        Some(s) -> parse_int(s),
        None -> default,
    }
}

fn main() with IO {
    print(feed(size(20000), 0, 0, 0, 0))
}
