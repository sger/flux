// Flow.Http — HTTP/1.1 server foundation (proposal 0174 Phase 3a).
//
// Phase 3a keeps `Bytes` as a transparent `String` alias. The Rust HTTP
// parser/writer remains authoritative; this Flux surface owns VM-safe async
// server orchestration so handlers stay on the VM fiber scheduler thread.

import Flow.Async exposing (..)
import Flow.Map as Map
import Flow.Stream as Stream
import Flow.Tcp as Tcp

module Flow.Http {

    public alias Bytes = String

    public data Method {
        Get,
        Post,
        Put,
        Delete,
        Patch,
        Head,
        Options,
    }

    public fn method_get() -> Method { Get }
    public fn method_post() -> Method { Post }
    public fn method_put() -> Method { Put }
    public fn method_delete() -> Method { Delete }
    public fn method_patch() -> Method { Patch }
    public fn method_head() -> Method { Head }
    public fn method_options() -> Method { Options }

    public data Request {
        Request {
            method:  Method,
            path:    String,
            headers: Map<String, String>,
            body:    Bytes,
        }
    }

    public data Response {
        Response {
            status:  Int,
            headers: Map<String, String>,
            body:    Bytes,
        }
    }

    public data StreamResponse<body> {
        StreamResponse {
            status:  Int,
            headers: Map<String, String>,
            body:    body,
        }
    }

    public data ServerConfig {
        ServerConfig {
            max_connections:    Int,
            max_header_bytes:   Int,
            max_body_bytes:     Int,
            request_timeout_ms: Int,
            worker_count:       Option<Int>,
        }
    }

    public data ServerHandle { ServerHandle(Int) }

    data HttpParseResult {
        HttpNeedMore,
        HttpParsed(Request, Int, Bool),
        HttpParseFailure(Int, String),
    }

    data HttpUrlResult {
        HttpUrlParsed(String, Int, String),
        HttpUrlFailure(Int, String),
    }

    data HttpResponseParseResult {
        HttpResponseNeedMore,
        HttpResponseParsed(Response, Int),
        HttpResponseFailure(Int, String),
    }

    intrinsic fn http_serve_config_prim<a>(listener_id: Int, scope_id: Int, config: a) -> Int = primop HttpServeConfig
    intrinsic fn http_parse_request_prim(raw: String, server_id: Int) -> HttpParseResult = primop HttpParseRequest
    intrinsic fn http_write_response_prim(resp: Response, keep_alive: Bool) -> String = primop HttpWriteResponse
    intrinsic fn http_write_chunked_head_prim<a>(resp: StreamResponse<a>) -> String = primop HttpWriteChunkedHead
    intrinsic fn http_write_chunk_prim(chunk: String) -> String = primop HttpWriteChunk
    intrinsic fn http_write_chunked_end_prim() -> String = primop HttpWriteChunkedEnd
    intrinsic fn http_parse_url_prim(url: String) -> HttpUrlResult = primop HttpParseUrl
    intrinsic fn http_write_request_prim(method: Method, host: String, target: String, headers: Map<String, String>, body: String) -> String = primop HttpWriteRequest
    intrinsic fn http_parse_response_prim(raw: String) -> HttpResponseParseResult = primop HttpParseResponse
    intrinsic fn http_register_connection_prim(server_id: Int, conn_id: Int) -> Unit = primop HttpRegisterConnection
    intrinsic fn http_unregister_connection_prim(server_id: Int, conn_id: Int) -> Unit = primop HttpUnregisterConnection
    intrinsic fn http_active_connection_count_prim(server_id: Int) -> Int = primop HttpActiveConnectionCount
    intrinsic fn http_is_shutting_down_prim(server_id: Int) -> Bool = primop HttpIsShuttingDown
    intrinsic fn http_server_stopped_prim(server_id: Int) -> Unit = primop HttpServerStopped
    intrinsic fn http_is_server_stopped_prim(server_id: Int) -> Bool = primop HttpIsServerStopped
    intrinsic fn http_shutdown_prim(h: Int) -> Unit = primop HttpShutdown
    intrinsic fn http_shutdown_now_prim(h: Int) -> Unit = primop HttpShutdownNow

    public fn default_config() -> ServerConfig {
        ServerConfig {
            max_connections:    10000,
            max_header_bytes:   65536,
            max_body_bytes:     8388608,
            request_timeout_ms: 30000,
            worker_count:       None,
        }
    }

    public fn server_config(
        max_connections:    Int,
        max_header_bytes:   Int,
        max_body_bytes:     Int,
        request_timeout_ms: Int
    ) -> ServerConfig {
        ServerConfig {
            max_connections:    max_connections,
            max_header_bytes:   max_header_bytes,
            max_body_bytes:     max_body_bytes,
            request_timeout_ms: request_timeout_ms,
            worker_count:       None,
        }
    }

    public fn response(status: Int, body: String) -> Response {
        Response {
            status:  status,
            headers: {},
            body:    body,
        }
    }

    public fn ok(body: String) -> Response {
        response(200, body)
    }

    public fn stream_response<a>(status: Int, headers: Map<String, String>, body: a) -> StreamResponse<a> {
        StreamResponse {
            status:  status,
            headers: headers,
            body:    body,
        }
    }

    public fn sse_event(payload: String) -> String {
        "data: " + payload + "\n\n"
    }

    public fn sse_named_event(name: String, payload: String) -> String {
        "event: " + name + "\n" + sse_event(payload)
    }

    public fn sse_response<a>(events: a) -> StreamResponse<a> {
        let with_content_type = Map.set({}, "Content-Type", "text/event-stream")
        let headers = Map.set(with_content_type, "Cache-Control", "no-cache")
        stream_response(200, headers, events)
    }

    public fn get(url: String) -> Response with Async, AsyncFail {
        request(Get, url, {}, "")
    }

    public fn post(url: String, body: String) -> Response with Async, AsyncFail {
        request(Post, url, {}, body)
    }

    public fn request(
        method:  Method,
        url:     String,
        headers: Map<String, String>,
        body:    String
    ) -> Response with Async, AsyncFail {
        match http_parse_url_prim(url) {
            HttpUrlFailure(status, message) -> fail(protocol_error(status, message)),
            HttpUrlParsed(host, port, target) -> request_parsed_url(method, host, port, target, headers, body)
        }
    }

    public fn serve_config(
        addr:    String,
        port:    Int,
        config:  ServerConfig,
        handler: (Request) -> Response with Async | e
    ) -> ServerHandle with Async, AsyncFail {
        serve_config_impl(addr, port, handler, config)
    }

    public fn serve_stream_config<a>(
        addr:    String,
        port:    Int,
        config:  ServerConfig,
        handler: (Request) -> StreamResponse<a> with Async | e
    ) -> ServerHandle with Async, AsyncFail {
        serve_stream_config_impl(addr, port, handler, config)
    }

    fn request_parsed_url(
        method:  Method,
        host:    String,
        port:    Int,
        target:  String,
        headers: Map<String, String>,
        body:    String
    ) -> Response with Async, AsyncFail {
        let conn = Tcp.connect(host, port)
        let wire = http_write_request_prim(method, host, target, headers, body)
        let ignored_write_request = Tcp.write_all(conn, wire)
        read_response_loop(conn, "")
    }

    fn read_response_loop(conn, buffer: String) -> Response with Async, AsyncFail {
        match http_parse_response_prim(buffer) {
            HttpResponseParsed(resp, consumed) -> close_and_return_response(conn, resp),
            HttpResponseFailure(status, message) -> close_and_fail_response(conn, status, "HTTP response parse failed"),
            HttpResponseNeedMore -> read_more_response(conn, buffer)
        }
    }

    fn close_and_return_response(conn, resp: Response) -> Response with Async {
        Tcp.close(conn)
        resp
    }

    fn close_and_fail_response(conn, status: Int, message: String) -> Response with Async, AsyncFail {
        let ignored_close = Tcp.close(conn)
        fail(protocol_error(status, message))
    }

    fn read_more_response(conn, buffer: String) -> Response with Async, AsyncFail {
        let chunk = Tcp.read(conn, 4096)
        if chunk == "" {
            let ignored_close = Tcp.close(conn)
            fail(protocol_error(0, "connection closed before complete HTTP response"))
        } else {
            read_response_loop(conn, buffer + chunk)
        }
    }

    fn serve_config_impl(
        addr:    String,
        port:    Int,
        handler,
        config:  ServerConfig
    ) -> ServerHandle with Async, AsyncFail {
        let listener = Tcp.listen(addr, port)
        let server_scope = new_scope()
        let server_id = http_serve_config_prim(Tcp.listener_id(listener), scope_id(server_scope), config)
        let request_timeout_ms = config.request_timeout_ms
        let max_connections = config.max_connections
        fn accept_loop_body() with Async, AsyncFail {
            accept_loop(server_id, listener, server_scope, max_connections, request_timeout_ms, handler)
        }
        fn serve_accept_body() with Async, AsyncFail {
            let ignored_accept_result = try_(accept_loop_body)
            http_server_stopped_prim(server_id)
        }
        let ignored_serve_fork = fork(server_scope, serve_accept_body)
        ServerHandle(server_id)
    }

    public fn serve(
        addr:    String,
        port:    Int,
        handler: (Request) -> Response with Async | e
    ) -> ServerHandle with Async, AsyncFail {
        let cfg = default_config()
        serve_config(addr, port, cfg, handler)
    }

    public fn serve_stream<a>(
        addr:    String,
        port:    Int,
        handler: (Request) -> StreamResponse<a> with Async | e
    ) -> ServerHandle with Async, AsyncFail {
        let cfg = default_config()
        serve_stream_config(addr, port, cfg, handler)
    }

    fn serve_stream_config_impl(
        addr:    String,
        port:    Int,
        handler,
        config:  ServerConfig
    ) -> ServerHandle with Async, AsyncFail {
        let listener = Tcp.listen(addr, port)
        let server_scope = new_scope()
        let server_id = http_serve_config_prim(Tcp.listener_id(listener), scope_id(server_scope), config)
        let request_timeout_ms = config.request_timeout_ms
        let max_connections = config.max_connections
        fn accept_loop_body() with Async, AsyncFail {
            accept_stream_loop(server_id, listener, server_scope, max_connections, request_timeout_ms, handler)
        }
        fn serve_accept_body() with Async, AsyncFail {
            let ignored_accept_result = try_(accept_loop_body)
            http_server_stopped_prim(server_id)
        }
        let ignored_serve_fork = fork(server_scope, serve_accept_body)
        ServerHandle(server_id)
    }

    public fn shutdown(h: ServerHandle) -> Unit with Async, AsyncFail {
        match h {
            ServerHandle(id) -> shutdown_id(id)
        }
    }

    public fn shutdown_now(h: ServerHandle) -> Unit with Async, AsyncFail {
        match h {
            ServerHandle(id) -> http_shutdown_now_prim(id)
        }
    }

    fn accept_loop(
        server_id:    Int,
        listener,
        server_scope,
        max_connections: Int,
        request_timeout_ms: Int,
        handler:      (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        if http_is_shutting_down_prim(server_id) { noop() }
        else if http_active_connection_count_prim(server_id) >= max_connections {
            let ignored_backpressure_sleep = sleep(50)
            accept_loop(server_id, listener, server_scope, max_connections, request_timeout_ms, handler)
        }
        else {
            fn accept_once() with Async, AsyncFail {
                Tcp.accept(listener)
            }
            fn accept_ok(conn) with Async, AsyncFail {
                accepted_connection(server_id, listener, server_scope, conn, max_connections, request_timeout_ms, handler)
            }
            let accept_result = try_(accept_once)
            result_or_else_async(
                accept_result,
                noop(),
                accept_ok
            )
        }
    }

    fn connection_worker(
        server_id: Int,
        conn,
        buffer:    String,
        request_timeout_ms: Int,
        handler:   (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        fn connection_body() with Async, AsyncFail {
            connection_loop(server_id, conn, buffer, request_timeout_ms, handler)
        }
        let ignored_connection_result = try_(connection_body)
        close_connection(server_id, conn)
    }

    fn connection_loop(
        server_id: Int,
        conn,
        buffer:    String,
        request_timeout_ms: Int,
        handler:   (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        match http_parse_request_prim(buffer, server_id) {
            HttpNeedMore -> need_more(server_id, conn, buffer, request_timeout_ms, handler),
            HttpParseFailure(status, message) -> write_response_and_close(server_id, conn, response(status, message)),
            HttpParsed(req, consumed, keep_alive) -> handle_parsed(server_id, conn, buffer, req, consumed, keep_alive, request_timeout_ms, handler)
        }
    }

    fn need_more(
        server_id: Int,
        conn,
        buffer:    String,
        request_timeout_ms: Int,
        handler:   (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        if http_is_shutting_down_prim(server_id) { noop() }
        else {
            fn read_once() with Async, AsyncFail {
                Tcp.read(conn, 4096)
            }
            let read_result = timeout_result(50, read_once)
            if result_is_timed_out(read_result) { connection_loop(server_id, conn, buffer, request_timeout_ms, handler) }
            else {
                let chunk = result_or(read_result, "")
                read_chunk(server_id, conn, buffer, chunk, request_timeout_ms, handler)
            }
        }
    }

    fn shutdown_id(id: Int) -> Unit with Async, AsyncFail {
        let ignored_shutdown = http_shutdown_prim(id)
        wait_for_shutdown(id)
    }

    fn accepted_connection(
        server_id:    Int,
        listener,
        server_scope,
        conn,
        max_connections: Int,
        request_timeout_ms: Int,
        handler:      (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        if http_is_shutting_down_prim(server_id) { Tcp.close(conn) }
        else {
            let ignored_register_connection = http_register_connection_prim(server_id, Tcp.connection_id(conn))
            let ignored_connection = connection_worker(server_id, conn, "", request_timeout_ms, handler)
            let ignored_accept_yield = yield_now()
            accept_loop(server_id, listener, server_scope, max_connections, request_timeout_ms, handler)
        }
    }

    fn read_chunk(
        server_id: Int,
        conn,
        buffer:    String,
        chunk:     String,
        request_timeout_ms: Int,
        handler:   (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        if chunk == "" { noop() }
        else { connection_loop(server_id, conn, buffer + chunk, request_timeout_ms, handler) }
    }

    fn write_response_and_close(server_id: Int, conn, resp: Response) -> Unit with Async, AsyncFail {
        let ignored_write_close = Tcp.write_all(conn, http_write_response_prim(resp, false))
        noop()
    }

    fn handle_parsed(
        server_id:  Int,
        conn,
        buffer:     String,
        req:        Request,
        consumed:   Int,
        keep_alive: Bool,
        request_timeout_ms: Int,
        handler:    (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        let rest = substring(buffer, consumed, len(buffer))
        let next_keep_alive = keep_alive && len(rest) > 0 && !http_is_shutting_down_prim(server_id)
        fn handler_done(resp, handler_ok) with Async, AsyncFail {
            write_response_then_continue(server_id, conn, rest, resp, handler_ok && next_keep_alive, request_timeout_ms, handler)
        }
        result_or_timeout_with_async(
            run_handler(req, request_timeout_ms, handler),
            response(504, "Gateway Timeout"),
            response(500, "Internal Server Error"),
            handler_done
        )
    }

    fn write_response_then_continue(
        server_id:       Int,
        conn,
        rest:            String,
        resp:            Response,
        next_keep_alive: Bool,
        request_timeout_ms: Int,
        handler:         (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        let ignored_write_continue = Tcp.write_all(conn, http_write_response_prim(resp, next_keep_alive))
        if next_keep_alive { connection_loop(server_id, conn, rest, request_timeout_ms, handler) }
        else { noop() }
    }

    fn run_handler(
        req: Request,
        request_timeout_ms: Int,
        handler: (Request) -> Response with Async | e
    ) with Async, AsyncFail {
        fn handler_body() with Async {
            handler(req)
        }
        timeout_result(request_timeout_ms, handler_body)
    }

    fn close_connection(server_id: Int, conn) {
        let ignored_unregister_connection = http_unregister_connection_prim(server_id, Tcp.connection_id(conn))
        Tcp.close(conn)
    }

    fn accept_stream_loop<a>(
        server_id:    Int,
        listener,
        server_scope,
        max_connections: Int,
        request_timeout_ms: Int,
        handler:      (Request) -> StreamResponse<a> with Async | e
    ) -> Unit with Async, AsyncFail {
        if http_is_shutting_down_prim(server_id) { noop() }
        else if http_active_connection_count_prim(server_id) >= max_connections {
            let ignored_backpressure_sleep = sleep(50)
            accept_stream_loop(server_id, listener, server_scope, max_connections, request_timeout_ms, handler)
        }
        else {
            fn accept_once() with Async, AsyncFail {
                Tcp.accept(listener)
            }
            fn accept_ok(conn) with Async, AsyncFail {
                accepted_stream_connection(server_id, listener, server_scope, conn, max_connections, request_timeout_ms, handler)
            }
            let accept_result = try_(accept_once)
            result_or_else_async(
                accept_result,
                noop(),
                accept_ok
            )
        }
    }

    fn accepted_stream_connection<a>(
        server_id:    Int,
        listener,
        server_scope,
        conn,
        max_connections: Int,
        request_timeout_ms: Int,
        handler:      (Request) -> StreamResponse<a> with Async | e
    ) -> Unit with Async, AsyncFail {
        if http_is_shutting_down_prim(server_id) { Tcp.close(conn) }
        else {
            let ignored_register_connection = http_register_connection_prim(server_id, Tcp.connection_id(conn))
            let ignored_connection = stream_connection_worker(server_id, conn, "", request_timeout_ms, handler)
            let ignored_accept_yield = yield_now()
            accept_stream_loop(server_id, listener, server_scope, max_connections, request_timeout_ms, handler)
        }
    }

    fn stream_connection_worker<a>(
        server_id: Int,
        conn,
        buffer:    String,
        request_timeout_ms: Int,
        handler:   (Request) -> StreamResponse<a> with Async | e
    ) -> Unit with Async, AsyncFail {
        fn connection_body() with Async, AsyncFail {
            stream_connection_loop(server_id, conn, buffer, request_timeout_ms, handler)
        }
        let ignored_connection_result = try_(connection_body)
        close_connection(server_id, conn)
    }

    fn stream_connection_loop<a>(
        server_id: Int,
        conn,
        buffer:    String,
        request_timeout_ms: Int,
        handler:   (Request) -> StreamResponse<a> with Async | e
    ) -> Unit with Async, AsyncFail {
        match http_parse_request_prim(buffer, server_id) {
            HttpNeedMore -> stream_need_more(server_id, conn, buffer, request_timeout_ms, handler),
            HttpParseFailure(status, message) -> write_response_and_close(server_id, conn, response(status, message)),
            HttpParsed(req, consumed, keep_alive) -> handle_stream_parsed(server_id, conn, req, request_timeout_ms, handler)
        }
    }

    fn stream_need_more<a>(
        server_id: Int,
        conn,
        buffer:    String,
        request_timeout_ms: Int,
        handler:   (Request) -> StreamResponse<a> with Async | e
    ) -> Unit with Async, AsyncFail {
        if http_is_shutting_down_prim(server_id) { noop() }
        else {
            fn read_once() with Async, AsyncFail {
                Tcp.read(conn, 4096)
            }
            let read_result = timeout_result(50, read_once)
            if result_is_timed_out(read_result) { stream_connection_loop(server_id, conn, buffer, request_timeout_ms, handler) }
            else {
                let chunk = result_or(read_result, "")
                if chunk == "" { noop() }
                else { stream_connection_loop(server_id, conn, buffer + chunk, request_timeout_ms, handler) }
            }
        }
    }

    fn handle_stream_parsed<a>(
        server_id:  Int,
        conn,
        req:        Request,
        request_timeout_ms: Int,
        handler:    (Request) -> StreamResponse<a> with Async | e
    ) -> Unit with Async, AsyncFail {
        fn handler_done(resp, handler_ok) with Async, AsyncFail {
            if handler_ok { write_stream_response_and_close(server_id, conn, resp) }
            else { write_response_and_close(server_id, conn, response(500, "Internal Server Error")) }
        }
        result_or_timeout_with_async(
            run_stream_handler(req, request_timeout_ms, handler),
            stream_response(504, {}, Stream.once("Gateway Timeout")),
            stream_response(500, {}, Stream.once("Internal Server Error")),
            handler_done
        )
    }

    fn run_stream_handler<a>(
        req: Request,
        request_timeout_ms: Int,
        handler: (Request) -> StreamResponse<a> with Async | e
    ) with Async, AsyncFail {
        fn handler_body() with Async {
            handler(req)
        }
        timeout_result(request_timeout_ms, handler_body)
    }

    fn write_stream_response_and_close<a>(server_id: Int, conn, resp: StreamResponse<a>) -> Unit with Async, AsyncFail {
        let ignored_head = Tcp.write_all(conn, http_write_chunked_head_prim(resp))
        match resp {
            StreamResponse { status, headers, body } -> write_stream_chunks_and_close(server_id, conn, body)
        }
    }

    fn write_stream_chunks_and_close<a>(server_id: Int, conn, body: a) -> Unit with Async, AsyncFail {
        match Stream.next(body) {
            Some(pair) -> do {
                if pair.0 == "" { noop() }
                else {
                    let ignored_chunk = Tcp.write_all(conn, http_write_chunk_prim(pair.0))
                }
                write_stream_chunks_and_close(server_id, conn, pair.1)
            },
            _ -> do {
                let ignored_end = Tcp.write_all(conn, http_write_chunked_end_prim())
                noop()
            }
        }
    }

    fn wait_for_shutdown(server_id: Int) -> Unit with Async, AsyncFail {
        if http_is_server_stopped_prim(server_id) && http_active_connection_count_prim(server_id) <= 0 { noop() }
        else {
            if http_active_connection_count_prim(server_id) <= 0 { http_shutdown_prim(server_id) }
            else { noop() }
            let ignored_shutdown_sleep = sleep(250)
            wait_for_shutdown(server_id)
        }
    }

    fn noop() -> Unit {}
}
