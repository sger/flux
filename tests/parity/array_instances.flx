// parity: vm, llvm
// expect: success
// bug: none — Stage 8's higher-kinded classes. A dictionary for a class
//      whose parameter is a type constructor, reached through two levels of
//      superclass evidence, is exactly the shape the two backends could
//      lay out or index differently.
// Proposal 0179 Stage 8: every Stage 8 class that has an `Array` instance.
//
// `Eq` over `Array` is *structural* rather than an instance — the solver
// synthesizes the evidence — which is why there is no `Eq<Array<a>>` in
// `Flow.Eq` alongside the `List` and `Option` ones. The rest are real
// instances.
//
// Expected: [|1, 2, 3|] [|2, 4|] [|7|] [|1, 1, 2, 2|] [||]
import Flow.Monad
import Flow.Monoid

fn main() {
    print(append([|1|], [|2, 3|]))
    print(fmap([|1, 2|], fn(x) { x * 2 }))
    let p: Array<Int> = pure(7)
    print(p)
    print(bind([|1, 2|], fn(x) { [|x, x|] }))
    let e: Array<Int> = mempty()
    print(e)
}
