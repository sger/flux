/// Equality.
///
/// `==` and `!=` desugar to `eq` and `neq`, so every type compared with an
/// operator is compared through this class. On a concrete primitive the
/// compiler lowers the operator straight to a primop, which is what lets the
/// instances below define `eq` as `x == y` without recursing.
///
/// The container instances carry a context — `Eq<a> => Eq<List<a>>` — so the
/// element type is a rigid variable inside the body and `==` cannot be applied
/// to it. They recurse through `eq` instead, routing each element through the
/// dictionary the constructor is handed. (Proposal 0179 Stage 7 and Stage 8.)
module Flow.Eq {
    public class Eq<a> {
        fn eq(x: a, y: a) -> Bool
        fn neq(x: a, y: a) -> Bool
    }

    public instance Eq<Int> {
        fn eq(x, y) { x == y }
        fn neq(x, y) { x != y }
    }

    public instance Eq<Float> {
        fn eq(x, y) { x == y }
        fn neq(x, y) { x != y }
    }

    public instance Eq<String> {
        fn eq(x, y) { x == y }
        fn neq(x, y) { x != y }
    }

    public instance Eq<Bool> {
        fn eq(x, y) { x == y }
        fn neq(x, y) { x != y }
    }

    // The container instances recurse through these constrained helpers, and
    // the helpers compare elements with `==` rather than `eq(...)`.
    //
    // The first reason once recorded here — that an instance method calling
    // its own class method on its own head type traps with
    // `E1009 unsupported comparison: List and List` — was a misreading. That
    // error came from the VM's comparison table, which had no arm for cons
    // cells and so rejected `[1, 2] == [1, 2]` wherever it appeared. With that
    // arm in place an instance method may recurse through `eq` directly, and
    // doing so is the clearer definition.
    //
    // What still stops it is a sibling call: `fn neq(xs, ys) { !eq(xs, ys) }`
    // gives the generated method a second dictionary parameter for
    // `Eq<List<a>>` — a constraint the instance being defined discharges — and
    // the call then fails on arity. See docs/known_issues.md#ki-078.
    //
    // The second reason still holds: a constrained function inside a `module`
    // block that calls a class method *by name* never receives its dictionary
    // and falls through to the runtime dispatch stub
    // (`panic: No instance of Eq.eq`). See docs/known_issues.md#ki-061.
    fn list_eq<a: Eq>(xs: List<a>, ys: List<a>) -> Bool {
        match xs {
            [h1 | t1] -> match ys {
                [h2 | t2] -> h1 == h2 && list_eq(t1, t2),
                _ -> false
            },
            _ -> match ys {
                [h | t] -> false,
                _ -> true
            }
        }
    }

    fn option_eq<a: Eq>(x: Option<a>, y: Option<a>) -> Bool {
        match x {
            Some(u) -> match y {
                Some(v) -> u == v,
                _ -> false
            },
            _ -> match y {
                Some(v) -> false,
                _ -> true
            }
        }
    }

    public instance Eq<a> => Eq<List<a>> {
        fn eq(xs, ys) { list_eq(xs, ys) }
        fn neq(xs, ys) { !list_eq(xs, ys) }
    }

    public instance Eq<a> => Eq<Option<a>> {
        fn eq(x, y) { option_eq(x, y) }
        fn neq(x, y) { !option_eq(x, y) }
    }
}
