// Type class constraint generation test.
// Verifies that operators and class method calls emit the correct
// constraints during type inference.
//
// Constraints generated:
//   1 + 2        → Num<Int>
//   10 - 3       → Num<Int>
//   4 * 5        → Num<Int>
//   1 == 1       → Eq<Int>
//   2 > 1        → Ord<Int>
//   eq(42, 42)   → Eq<Int> (class method call)
//   add(10, 20)  → Num<Int> (class method call)
//
// The instances the prelude already supplies are not redeclared here. Since
// Proposal 0179 Stage 8 the standard classes are Flux source in `Flow.Eq`,
// `Flow.Num` and `Flow.Show`, which every module imports, so `Int` and `Bool`
// arrive with their instances; declaring them again is a duplicate instance.
// The calls below dispatch through those prelude instances.



fn main() with IO {
    // Operator constraints
    print(1 + 2)
    print(10 - 3)
    print(4 * 5)
    print(1 == 1)
    print(2 > 1)

    // Class method call constraints
    print(eq(42, 42))
    print(add(10, 20))
    print(sub(100, 42))
    print(mul(3, 7))
    print(div(84, 2))
}