// 0189 V7: the value array_push stores, then given to a call that releases
// it.
// It calls the primop by its bare name: through the Flow wrapper the
// argument is never released (KI-121), which hides this.

fn arr(n) {
    [|[n], [n + 1]|]
}

fn list(n) {
    [n, n + 1]
}

fn discard(xs, keep) {
    if keep { xs } else { [] }
}

fn main() {
    let v = list(5)
    let b = array_push(arr(1), v)
    let d = discard(v, false)
    print(b)
    print(d)
}
