// parity: vm, llvm
// expect: success
// bug: KI-116. Reading `x` inside `do { let t = x; t }` leaves `x`
//      uninitialised on the VM, so the second print shows `<uninit>`.
//      Found by `cargo xtask rewrite --kind let-wrap` (0190 S7).
// skip-way: vm, vm_cached, vm_strict, vm_opt: KI-116 the VM clears a variable a do-block let reads
// parity-expected-stdout-begin
// 5
// 5
// parity-expected-stdout-end

fn main() with IO {
    let x = 5
    print(do { let t = x; t })
    print(x)
}
