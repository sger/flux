// nqueens_choice without effects: the same search, one column at a time,
// trying every row and counting the placements that reach the last column.
import Flow.Env as Env
import Flow.Array as Array

fn safe(queen: Int, diag: Int, xs: List<Int>) -> Bool {
    match xs {
        [] -> true,
        [q | qs] -> if queen != q && queen != q + diag && queen != q - diag {
            safe(queen, diag + 1, qs)
        } else { false },
    }
}

fn place(size: Int, column: Int, rest: List<Int>) -> Int {
    if column > size { 1 } else { rows(size, column, rest, 1, 0) }
}

fn rows(size: Int, column: Int, rest: List<Int>, row: Int, a: Int) -> Int {
    if row > size { a } else {
        let found = if safe(row, 1, rest) { place(size, column + 1, [row | rest]) } else { 0 }
        rows(size, column, rest, row + 1, a + found)
    }
}

// The workload size: the program's first argument, or the size the suite
// was written with. `cargo xtask bench` passes a smaller one to the VM.
fn size(default: Int) -> Int with Env {
    match Array.get(Env.args(), 1) {
        Some(s) -> parse_int(s),
        None -> default,
    }
}

fn main() with IO {
    print(place(size(12), 1, []))
}
