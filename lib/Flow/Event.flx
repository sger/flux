import Flow.Async as Async
import Flow.Channel as Channel

module Flow.Event {
    public data Event<a> { Event(Int) }
    public data Poll<a> { Ready(a), Pending }

    intrinsic fn event_recv_id(id: Int) -> Int = primop EventRecv
    intrinsic fn event_send_id<a>(id: Int, value: a) -> Int = primop EventSend
    intrinsic fn event_send_move_id<a>(id: Int, value: a) -> Int = primop EventSendMove
    intrinsic fn event_after_id(ms: Int) -> Int = primop EventAfter
    intrinsic fn event_always_id<a>(value: a) -> Int = primop EventAlways
    intrinsic fn event_never_id() -> Int = primop EventNever
    intrinsic fn event_choose_ids(ids: List<Int>) -> Int = primop EventChoose
    intrinsic fn event_wrap_id<a, b>(id: Int, f: (a) -> b) -> Int = primop EventWrap
    intrinsic fn event_poll_id<a>(id: Int) -> Poll<a> = primop EventPoll
    intrinsic fn event_wait_id(id: Int) -> Unit with Async = primop EventWait
    intrinsic fn event_guard_id(thunk: () -> Int) -> Int = primop EventGuard
    intrinsic fn event_with_nack_id(nack_ch: Int, child: Int) -> Int = primop EventWithNack

    fn ids<a>(events: List<Event<a>>) -> List<Int> {
        match events {
            [Event(id) | rest] -> [id | ids(rest)],
            _ -> []
        }
    }

    public fn recv<a: Sendable>(ch: Channel<a>) -> Event<Option<a>> {
        match ch { Channel(id) -> Event(event_recv_id(id)) }
    }

    public fn send<a: Sendable>(ch: Channel<a>, value: a) -> Event<Unit> {
        match ch { Channel(id) -> Event(event_send_id(id, value)) }
    }

    /// Build a send event by ownership transfer. Prefer this when `value` is
    /// not aliased; the runtime attempts a zero-copy transfer and falls back
    /// to a deep copy when the value is shared.
    public fn send_move<a: Sendable>(ch: Channel<a>, value: a) -> Event<Unit> {
        match ch { Channel(id) -> Event(event_send_move_id(id, value)) }
    }

    public fn after(ms: Int) -> Event<Unit> {
        Event(event_after_id(ms))
    }

    public fn always<a>(value: a) -> Event<a> {
        Event(event_always_id(value))
    }

    public fn never<a>() -> Event<a> {
        Event(event_never_id())
    }

    public fn choose<a>(events: List<Event<a>>) -> Event<a> {
        match events {
            [_ | _] -> Event(event_choose_ids(ids(events))),
            _ -> panic("Event.choose called on empty list")
        }
    }

    public fn wrap<a, b>(event: Event<a>, f: (a) -> b) -> Event<b> {
        match event { Event(id) -> Event(event_wrap_id(id, f)) }
    }

    /// CML-style guard: defer building the event until **sync-time**.
    ///
    /// `f` is not run while the event tree is constructed; it runs once, the
    /// first time `sync` polls this node, and the event it returns is what the
    /// surrounding `choose` / `sync` actually races on. Re-polls reuse the
    /// memoized result, so `f`'s side effects happen exactly once per sync.
    public fn guard<a>(f: () -> Event<a>) -> Event<a> {
        Event(event_guard_id(fn() {
            match f() { Event(id) -> id }
        }))
    }

    /// CML-style negative acknowledgement.
    ///
    /// `f` receives a nack event that **fires** (yielding `()`) when, at the
    /// enclosing `sync` commit, the event built by `f` is *not* the branch
    /// selected — letting a loser clean up a partially-started operation. If
    /// this branch wins, the nack never fires (a fiber blocked on it parks
    /// until `run_async` tears down, as in Concurrent ML). Implemented over a
    /// 1-capacity channel that the runtime sends to when this branch loses.
    fn to_unit<a>(x: a) -> Unit { }

    // The callback's effect row is written as the `Async` alias expansion
    // (`Suspend, Fork, GetContext, AsyncFail`) rather than `Async`: the alias
    // does not unify across modules in this higher-order position when called
    // qualified (the same limitation `run_selected` hits); the expansion does.
    //
    // The channel handle `c` is destructured exactly once into the raw `cid`,
    // which is then reused both before and after `f`. Using the `Channel` value
    // twice (e.g. `recv(c)` then `match c`) makes the native backend drop it on
    // first use and read freed memory on the second — `cid` is a plain Int and
    // sidesteps that.
    public fn with_nack<a>(
        f: (Event<Unit>) -> Event<a> with Suspend, Fork, GetContext, AsyncFail | e
    ) -> Event<a> with Suspend, Fork, GetContext, AsyncFail | e {
        let cid: Int = match Channel.make(1) { Channel(id) -> id }
        let nack_ev: Event<Unit> = Event(event_wrap_id(event_recv_id(cid), to_unit))
        let main = f(nack_ev)
        match main {
            Event(mid) -> Event(event_with_nack_id(cid, mid))
        }
    }

    /// Synchronize on an event. Sync consumes the whole event tree when it
    /// commits a result; build a fresh event before syncing again. Sharing a
    /// sub-event between two choices is invalid after either choice commits.
    /// Wait notifications are readiness hints, so sync may repoll and wait
    /// again if another fiber wins the readiness race first.
    public fn sync<a>(event: Event<a>) -> a with Async {
        match event {
            Event(id) -> sync_id(id)
        }
    }

    public fn run_selected<a, e>(f: (() -> a with Async | e)) -> a with Async | e {
        f()
    }

    fn sync_id<a>(id: Int) -> a with Async {
        match event_poll_id(id) {
            Ready(value) -> value,
            Pending -> do {
                event_wait_id(id)
                sync_id(id)
            }
        }
    }
}
