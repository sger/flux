// A handler that never resumes: the frames that performed the operation
// are gone, and the stack says so.
effect Fail {
    raise : (String) -> Int
}

fn safe_div(a: Int, b: Int) -> Int with Fail {
    if b == 0 {
        perform Fail.raise("division by zero")
    } else {
        a / b
    }
}

fn compute() -> Int with Fail {
    let q = safe_div(10, 0)
    q + 1
}

fn main() with IO {
    let result = compute() handle Fail {
        raise(resume, msg) -> len(msg)
    }
    print(to_string(result))
}
