// Debug parity (0188 S7): a handler that resumes twice. In its arm, the
// frames the perform suspended show below it; in each shot, the resumed
// frames show above it.
// dbg: break 32
// dbg: continue
// dbg: bt
// dbg: break 22
// dbg: continue
// dbg: bt
// dbg: locals
// dbg: continue
// dbg: bt
// dbg: locals
// dbg: continue

effect Flip {
    flip : () -> Bool
}

fn decide() -> Int with Flip {
    let b = perform Flip.flip()
    if b { 1 } else { 2 }
}

fn twice() -> Int with Flip {
    let d = decide()
    d * 10
}

fn main() with IO {
    let result = twice() handle Flip {
        flip(resume) -> resume(true) + resume(false)
    }
    print(to_string(result))
}

// dbg-check: stop <handler Flip.flip> effect_yield.flx:32
// dbg-check: frame <handler Flip.flip> effect_yield.flx:32
// dbg-check: frame decide effect_yield.flx:21
// dbg-check: frame twice effect_yield.flx:26
// dbg-check: frame main effect_yield.flx:31
// dbg-check: stop decide effect_yield.flx:22
// dbg-check: frame decide effect_yield.flx:22
// dbg-check: frame twice effect_yield.flx:26
// dbg-check: frame <handler Flip.flip> effect_yield.flx:32
// dbg-check: frame main effect_yield.flx:31
// dbg-check: b = true
// dbg-check: stop decide effect_yield.flx:22
// dbg-check: frame decide effect_yield.flx:22
// dbg-check: frame twice effect_yield.flx:26
// dbg-check: frame <handler Flip.flip> effect_yield.flx:32
// dbg-check: frame main effect_yield.flx:31
// dbg-check: b = false
// dbg-check: finished
