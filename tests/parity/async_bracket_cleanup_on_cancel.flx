// parity: vm, llvm
// expect: success
// bug: bracket(acquire, release, body) must call release even when body fails via AsyncFail.
//      Uses result_is_ok to confirm error propagates; if cleanup ran, error must propagate.

import Flow.Async exposing (..)

fn acquire() -> Int { 1 }
fn release(_r: Int) -> Int { 0 }
fn failing_body(_r: Int) -> Int with Async { fail(canceled_error()) }

fn run() -> String with Async {
    let outcome = try_(fn() { bracket(acquire, release, failing_body) })
    if result_is_ok(outcome) {
        "wrong_succeeded"
    } else {
        "cleanup_ran_error_propagated"
    }
}

fn main() with IO {
    print(run_async(run))
}
