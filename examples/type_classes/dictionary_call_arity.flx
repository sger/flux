// Baseline supported behavior: concrete and polymorphic dictionary calls.
// Expected output:
// 42

class Sizeable<a> {
    fn size(x: a) -> Int
}

instance Sizeable<Int> {
    fn size(x) { x }
}

fn twice<a: Sizeable>(x: a) -> Int {
    size(x) + size(x)
}

fn ssize<a: Sizeable>(x: a, label: String) -> Int {
    size(x)
}

fn main() with IO {
    print(twice(21))
    print(ssize(10, "mixed"))
}
