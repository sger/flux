// parity: vm, llvm
// expect: success
// Tests the Flow.String primops — concat, length, slice — and the helpers
// built on them.
// parity-expected-stdout-begin
// "hello world"
// 5
// "hello"
// "x-y-z"
// [|"a", "b", "c"|]
// true
// true
// true
// parity-expected-stdout-end

import Flow.String

fn main() with IO {
    print(String.string_concat("hello", " world"))
    print(String.string_len("hello"))
    print(String.string_slice("hello world", 0, 5))
    print(String.join([|"x", "y", "z"|], "-"))
    print(String.chars("abc"))
    print(String.starts_with("hello", "he"))
    print(String.ends_with("hello", "lo"))
    print(String.str_contains("hello world", "o w"))
}
