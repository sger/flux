// expect: compile_error

// E082: constructor arity mismatch in match pattern.

data Pair {
    Pair(Int, Int),
}

fn bad(x: Pair) -> Int {
    match x { //~ E015
        Pair(a) -> a, //~ E085
    }
}

fn main() {
    bad(Pair(1, 2))
}
