// parity-expected-stdout-end

/*
Test: Arithmetic operations
*/

// Program entry point.
fn main() with IO {
    println(1 + 2)
    println(10 - 3)
    println(4 * 5)
    println(15 / 3)
    println(2 + 3 * 4)

    println(10 % 3)   // 1
    println(7 % 2)     // 1 (odd check)
    println(8 % 2)     // 0 (even check)
    println(10 % 3) // 1.5 (float modulo)
    

    
}