import Flow.Array as Array
import Flow.List as List
import Flow.Map as Map
import Flow.String as String

// Ownership-transfer stress coverage for the Aether dup/drop planner (KI-013).
//
// Every test here follows the shape that corrupted memory on the native
// backend: destructure a value with a pattern, then transfer the *borrowed*
// pattern fields into an owning constructor (MakeTuple / MakeList / MakeArray
// / MakeHash / an ADT `Con`), sometimes while the original scrutinee is still
// reachable. Each field must be duplicated on transfer; if it is not, the
// scrutinee's storage is released while the new value still points at it.
//
// These run under `assert_backends_agree`, so a refcount fault shows up as a
// VM/native divergence rather than as a silent wrong answer.

data Pair { Pair(String, List<Int>) }
data Wrap { Wrap(Pair) }

// --- tuple fields into a tuple ---

fn rebuild_tuple(entry) {
    match entry {
        (key, value) -> (key, value),
    }
}

fn test_tuple_field_transfer_into_tuple() {
    let original = ("k", [1, 2, 3])
    let rebuilt = rebuild_tuple(original)
    assert_eq(rebuilt.0, "k")
    assert_eq(List.length(rebuilt.1), 3)
    // The scrutinee must still be intact after the rebuild.
    assert_eq(original.0, "k")
    assert_eq(List.length(original.1), 3)
}

// --- tuple fields into a list (the exact KI-013 shape) ---

fn assoc_set(table, key, value) {
    match table {
        [(candidate, existing) | rest] ->
            if candidate == key {
                [(candidate, value) | rest]
            } else {
                [(candidate, existing) | assoc_set(rest, key, value)]
            },
        _ -> [(key, value)],
    }
}

fn describe(table) {
    let parts = List.map(table, fn(entry) {
        match entry {
            (k, v) -> k + ":" + to_string(List.length(v)),
        }
    })
    String.join(Array.from_list(parts), ",")
}

fn test_assoc_rebuild_preserves_elements() {
    let table = [("a", [1]), ("b", [2, 2]), ("c", [3, 3, 3])]
    let updated = assoc_set(table, "b", [9, 9, 9, 9])
    assert_eq(List.length(updated), 3)
    assert_eq(describe(updated), "a:1,b:4,c:3")
    // Original table untouched.
    assert_eq(describe(table), "a:1,b:2,c:3")
}

// --- list fields into a list, scrutinee still live ---

fn duplicate_head(xs) {
    match xs {
        [head | rest] -> ([head | rest], [head | [head | rest]]),
        _ -> ([], []),
    }
}

fn test_list_head_transferred_twice() {
    let xs = [[1, 2], [3, 4]]
    let pair = duplicate_head(xs)
    assert_eq(List.length(pair.0), 2)
    assert_eq(List.length(pair.1), 3)
    assert_eq(List.length(xs), 2)
}

// --- nested patterns (the `nested_pattern` dup path) ---

fn unwrap_nested(w) {
    match w {
        Wrap(Pair(name, items)) -> (name, items),
    }
}

fn test_nested_pattern_field_transfer() {
    let w = Wrap(Pair("n", [1, 2, 3]))
    let out = unwrap_nested(w)
    assert_eq(out.0, "n")
    assert_eq(List.length(out.1), 3)
}

fn test_nested_pattern_into_adt() {
    let w = Wrap(Pair("n", [7, 7]))
    let rebuilt = match w {
        Wrap(Pair(name, items)) -> Wrap(Pair(name, items)),
    }
    let out = unwrap_nested(rebuilt)
    assert_eq(out.0, "n")
    assert_eq(List.length(out.1), 2)
}

// --- array construction from pattern fields ---

fn pair_to_array(entry) {
    match entry {
        (a, b) -> Array.from_list([a, b]),
    }
}

fn test_tuple_fields_into_array() {
    let entry = ([1, 2], [3, 4, 5])
    let arr = pair_to_array(entry)
    assert_eq(Array.length(arr), 2)
    match Array.get(arr, 0) {
        Some(first) -> assert_eq(List.length(first), 2),
        None -> assert_true(false),
    }
    match Array.get(arr, 1) {
        Some(second) -> assert_eq(List.length(second), 3),
        None -> assert_true(false),
    }
    assert_eq(List.length(entry.0), 2)
}

// --- hash construction from pattern fields ---

fn pair_to_map(entry) {
    match entry {
        (key, value) -> {key: value},
    }
}

fn test_tuple_fields_into_map() {
    let entry = ("key", [1, 2, 3])
    let m = pair_to_map(entry)
    match Map.get(m, "key") {
        Some(found) -> assert_eq(List.length(found), 3),
        None -> assert_true(false),
    }
    assert_eq(entry.0, "key")
    assert_eq(List.length(entry.1), 3)
}

fn test_map_set_from_pattern_fields() {
    let entry = ("key", [1, 2, 3])
    let m = match entry {
        (k, v) -> Map.set(Map.set({}, k, v), "other", v),
    }
    assert_eq(Map.size(m), 2)
    match Map.get(m, "other") {
        Some(found) -> assert_eq(List.length(found), 3),
        None -> assert_true(false),
    }
    assert_eq(entry.0, "key")
}

// --- map over a list of tuples, then rebuild (KI-013 rendering path) ---

fn test_map_over_tuple_list_after_rebuild() {
    let table = assoc_set([("x", [1]), ("y", [2])], "z", [3, 3, 3])
    let sizes = List.map(table, fn(entry) {
        match entry {
            (_, v) -> List.length(v),
        }
    })
    assert_eq(List.sum(sizes), 5)
    let keys = List.map(table, fn(entry) {
        match entry {
            (k, _) -> k,
        }
    })
    assert_eq(String.join(Array.from_list(keys), ""), "xyz")
}

// --- deeply nested collection rebuild ---

fn test_nested_collection_rebuild() {
    let nested = [("outer", [("inner", [1, 2])])]
    let rebuilt = List.map(nested, fn(entry) {
        match entry {
            (k, inner) -> (k, List.map(inner, fn(pair) {
                match pair {
                    (ik, iv) -> (ik, iv),
                }
            })),
        }
    })
    assert_eq(List.length(rebuilt), 1)
    let outer = match rebuilt {
        [head | _] -> head,
        _ -> ("", []),
    }
    assert_eq(outer.0, "outer")
    assert_eq(List.length(outer.1), 1)
}

// --- a field used twice in one constructor (needs two dups) ---

fn test_field_used_twice_in_one_constructor() {
    let entry = ("dup", [1, 2, 3])
    let out = match entry {
        (k, v) -> (k, v, k, v),
    }
    assert_eq(out.0, "dup")
    assert_eq(out.2, "dup")
    assert_eq(List.length(out.1), 3)
    assert_eq(List.length(out.3), 3)
    assert_eq(entry.0, "dup")
}

// --- KI-018: recursive rebuild must not mutate a shared source list ---
//
// `bump` recurses on `rest`, a borrowed field of `xs`. In the `shared` arm of
// the drop-specialization, `rest` is passed borrowed to the recursive call,
// whose own uniqueness check then sees RC==1 and reuses the cell in place —
// mutating a list the caller still holds. This is covered by the VM/native
// parity test below.

fn bump_payload(xs, target) {
    match xs {
        [(k, v) | rest] ->
            if k == target {
                [(k, [9, 9, 9, 9]) | rest]
            } else {
                [(k, v) | bump_payload(rest, target)]
            },
        _ -> [],
    }
}

fn nth_payload_len(xs) {
    match xs {
        [_ | rest] -> match rest {
            [(_, v) | _] -> List.length(v),
            _ -> -1,
        },
        _ -> -1,
    }
}

fn test_recursive_rebuild_does_not_mutate_source() {
    let xs = [(1, [1]), (2, [2, 2]), (3, [3, 3, 3])]
    let ys = bump_payload(xs, 2)
    assert_eq(nth_payload_len(ys), 4)
    assert_eq(nth_payload_len(xs), 2)
}

fn test_two_rebuilds_are_independent() {
    let xs = [(1, [1]), (2, [2, 2]), (3, [3, 3, 3])]
    let ys = bump_payload(xs, 2)
    let zs = bump_payload(xs, 3)
    assert_eq(nth_payload_len(ys), 4)
    assert_eq(nth_payload_len(zs), 2)
    assert_eq(nth_payload_len(xs), 2)
}
