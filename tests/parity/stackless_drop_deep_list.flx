// parity: vm, llvm
// expect: success
// bug: recursive flux_drop stack-overflows on deep lists.
//      stackless drop traversal uses parent chain in header._reserved field.

fn build_list(n, acc) {
    if n <= 0 { acc }
    else { build_list(n - 1, [n | acc]) }
}

fn main() with IO {
    // Build a list deep enough to exercise stackless drop while staying within
    // the parity harness timeout on fresh no-cache VM runs.
    let big = build_list(50000, [])
    // Sum first and last to prove it's alive.
    let first = match big {
        [h | _] -> h,
        _ -> -1,
    }
    print(first)
    // Drop happens implicitly when big goes out of scope.
    print("ok")
}
