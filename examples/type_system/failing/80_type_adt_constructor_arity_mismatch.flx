// expect: compile_error

// E082: constructor arity mismatch using `type ... = ... | ...` ADT sugar.

type PairI = Pair(Int, Int)

fn bad(x: PairI) -> Int {
    match x { //~ E015
        Pair(a) -> a, //~ E085
    }
}

fn main() {
    bad(Pair(1, 2))
}
