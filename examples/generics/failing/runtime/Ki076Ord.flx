// The module half of ../runtime/ki_076_operator_in_module.flx. See that file
// for the gap. This one compiles clean on its own — the failure only appears
// when `bigger` is actually called, which is why the pair is needed.
//
// The module *name* has to match the file stem, and a module file may not
// contain `main` (E028), so a gap that requires a `module` block cannot be
// shown in a single file.

module Ki076Ord {
    public data V { V(Int) }

    fn raw(x: V) -> Int {
        match x { V(n) -> n }
    }

    public instance Eq<V> {
        fn eq(x, y) { raw(x) == raw(y) }
        fn neq(x, y) { raw(x) != raw(y) }
    }

    public instance Eq<V> => Ord<V> {
        fn compare(x, y) { if raw(x) < raw(y) { -1 } else { if raw(x) > raw(y) { 1 } else { 0 } } }
        fn lt(x, y) { raw(x) < raw(y) }
        fn lte(x, y) { raw(x) <= raw(y) }
        fn gt(x, y) { raw(x) > raw(y) }
        fn gte(x, y) { raw(x) >= raw(y) }
    }

    // The same function at the top level of a script works and returns `V(9)`.
    // Inside this `module` block the `<=` does not dispatch.
    public fn bigger<a: Ord>(x: a, y: a) -> a {
        if x <= y { y } else { x }
    }

    public fn demo() -> Int {
        raw(bigger(V(1), V(9)))
    }
}
