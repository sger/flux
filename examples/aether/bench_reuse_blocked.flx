/*
Aether plain-Reuse benchmark control: recursive list rebuild with an
explicit token-touching precompute let that should keep plain Reuse disabled.
*/

// parity-expected-stdout-begin
// "blocked: result head = 101"
// parity-expected-stdout-end

fn build_list(n) {
    // Continue build recursion.
    fn build_go(i, acc) {
        if i <= 0 { acc }
        else { build_go(i - 1, [i | acc]) }
    }
    build_go(n, [])
}

// Touching the scrutinee token in a field-computation call should block plain
// Reuse while keeping the observable result the same. The call must own the
// token: one that only borrowed it would let the caller release the cell
// after the call, and that release becomes a reuse. Lengths are never
// negative, so the branch that keeps the token never runs.
fn touch_token(token, value) {
    if len(token) < 0 { match [token] { _ -> value } } else { value }
}

// Helper for map blocked.
@fip fn map_blocked(xs, f) {
    match xs {
        // The fields are read before the call that takes the cell.
        [h | t] -> [f(h) | touch_token(xs, map_blocked(t, f))],
        _ -> [],
    }
}

// Helper for bench map.
fn bench_map(xs, iterations) {
    // Helper for go.
    fn go(i, current) {
        if i <= 0 { current }
        else { go(i - 1, map_blocked(current, \x -> x + 1)) }
    }
    go(iterations, xs)
}

// Program entry point.
fn main() with IO {
    let size = 5000
    let iterations = 100
    let xs = build_list(size)
    let mapped = bench_map(xs, iterations)
    print("blocked: result head = #{first(mapped)}")
}