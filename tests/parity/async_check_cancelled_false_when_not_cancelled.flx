// parity: vm, llvm
// expect: success
// bug: Async.check_cancelled (proposal 0174 Phase 2 slice 2-iv) must
//      return false in a non-cancelled fiber. VM and LLVM/native must
//      agree.

import Flow.Async exposing (..)

fn body() -> Bool with Async {
    check_cancelled()
}

fn main() with IO {
    let v = run_async(body)
    print(v)
}
