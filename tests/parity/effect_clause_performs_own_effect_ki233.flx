// parity: vm, llvm
// expect: compile_error
// bug: KI-233. A clause runs under its own handler at run time, so a clause
//      that performs its own effect, here to forward to the outer Ask
//      handler as handler_sieve does, reached itself again: a stack
//      overflow on the VM, a hang natively. Until the runtimes are fixed it
//      is rejected at compile time.

effect Ask {
    ask : () -> Int
}

fn asks() -> Int with Ask {
    perform Ask.ask()
}

fn inner() -> Int with Ask {
    asks() handle Ask { ask(resume) -> resume(perform Ask.ask() + 1) } //~ E400
}

fn main() with IO {
    print(inner() handle Ask { ask(resume) -> resume(100) })
}
