// parity: vm, llvm
// expect: success
//
// `Async.current_worker_count()` must report the same scheduler-configured
// worker count on both backends when the user pins it explicitly.

import Flow.Async exposing (..)

fn body() -> Int with Async { current_worker_count() }

fn main() with IO {
    print(run_async_with_workers(4, body))
    print(run_async_with_workers(1, body))
    print(run_async_with(with_worker_count(7), body))
}
