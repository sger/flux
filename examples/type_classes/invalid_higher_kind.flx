// Baseline behavior: this deliberately gives a value type to a constructor
// parameter. Complete kind rejection belongs to Stage 1.
// Expected current baseline output:
// 1

class Functor<f> {
    fn fmap<a, b>(x: f<a>, func: (a) -> b) -> f<b>
}

instance Functor<Int> {
    fn fmap(x, func) { x }
}

fn main() with IO {
    print(1)
}
