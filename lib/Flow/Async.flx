// Flow.Async — structured concurrency primitives (proposal 0174 Phase 1b).
//
// All public functions that carry `with Async` are backed by fiber primops
// (163–165 in CorePrimOp). On the VM path the primops give sequentially-
// equivalent semantics: run_async calls the action synchronously, yield_now
// is a no-op, sleep blocks the OS thread. Real M:N fiber switching on the
// native backend lands in proposal 0174 Phase 2.
//
// The `Async` effect alias (`<Suspend | Fork | GetContext | AsyncFail>`) is
// compiler-seeded in `src/compiler/mod.rs` and declared in `lib/Flow/Effects.flx`.
//
// Parser note: Flux does not yet support `with <effect>` in a non-final
// function parameter type (the comma separating parameters is ambiguous with
// the row separator inside the `with` clause). For functions that take multiple
// callbacks, only the *last* callback before `) ->` may carry `with Async`.
// Callers pass named `with Async` functions; multi-callback combinators use
// unannotated parameter types for all but the final argument.

module Flow.Async {

    // ── Error type ────────────────────────────────────────────────────

    /// Errors that may be raised by async operations.
    public data AsyncError {
        /// The enclosing scope was cancelled before this fiber completed.
        Canceled,
        /// A `timeout` or `timeout_result` deadline expired.
        TimedOut,
        /// TCP / UDP I/O failure. Fields: (errno, message, syscall).
        IoError(Int, String, String),
        /// DNS resolution failure. Fields: (code, message, host).
        DnsError(Int, String, String),
        /// The remote peer closed the connection.
        ConnectionClosed,
        /// Address could not be parsed.
        InvalidAddress(String),
    }

    // ── Structural handles ────────────────────────────────────────────

    /// Cancellation boundary. Fibers forked inside a `scope` call are
    /// attached to the `Scope` value; cancelling the scope cancels all
    /// of them.
    public data Scope { Scope(Int) }

    /// Opaque fiber identifier.
    public data FiberId { FiberId(Int) }

    /// Handle returned by an async operation registration.
    public data CancelHandle { CancelHandle(Int) }

    // ── Fiber primop intrinsics ───────────────────────────────────────

    /// Entry point: run `action` under the fiber scheduler.
    /// VM: synchronous call. Native: installs Async effect handler.
    intrinsic fn fiber_run_async<a>(action: () -> a with Async) -> a = primop FiberRunAsync

    /// Phase 2 slice 2-vii: run an async action with explicit RuntimeConfig
    /// knobs. Each int is a tagged Flux Int; passing 0 means "use the default
    /// for that knob".
    intrinsic fn fiber_run_async_with_prim<a>(workers: Int, fs_pool: Int, dns_pool: Int, action: () -> a with Async) -> a = primop FiberRunAsyncWith

    /// Cooperative yield. VM: no-op. Native: reschedules current fiber.
    intrinsic fn fiber_yield_now_prim() -> Unit = primop FiberYieldNow

    /// Phase 2 slice 2-iv: poll whether the current fiber's enclosing
    /// scope has been cancelled. Returns `true` iff cancelled. No
    /// suspend, no backend round-trip — a scheduler flag check.
    intrinsic fn fiber_check_cancelled_prim() -> Bool = primop FiberCheckCancelled

    /// Wall-clock sleep for `ms` milliseconds.
    /// VM: blocks OS thread. Native: suspends fiber, wakes on timer.
    intrinsic fn fiber_sleep_prim(ms: Int) -> Unit = primop FiberSleep

    /// Raise an `AsyncError` in the current fiber.
    intrinsic fn fiber_fail_prim<a>(err: AsyncError) -> a = primop FiberFail

    /// Run two fibers concurrently, returning both results as a pair
    /// (proposal 0174 Phase 1b-vi-b₂.2). VM: real overlap via the fiber
    /// scheduler. Native: 1b-vi-d.
    intrinsic fn fiber_both_prim<a, b>(f: (() -> a with Async | e1), g: (() -> b with Async | e2)) -> (a, b) = primop FiberBoth

    /// Run two fibers concurrently, returning the first result that arrives.
    /// VM: real overlap; loser cancelled immediately on winner resolution (1b-vi-c).
    intrinsic fn fiber_race_prim<a>(f: (() -> a with Async | e1), g: (() -> a with Async | e2)) -> a = primop FiberRace

    /// Bound `f` by `ms` milliseconds: returns `Some(f())` if `f` completes
    /// in time, `None` if the timer fires first (proposal 0174 Phase 1b-vi
    /// follow-up). VM: real overlap via fiber scheduler. Native: 1b-vi-d.
    intrinsic fn fiber_timeout_prim<a>(ms: Int, f: () -> a with Async) -> Option<a> = primop FiberTimeout

    /// Allocate a new cancellation scope (proposal 0174 1b-vi-c).
    intrinsic fn fiber_new_scope_prim() -> Scope = primop FiberNewScope

    /// Fork a child fiber attached to scope `s` (proposal 0174 1b-vi-c).
    intrinsic fn fiber_fork_scoped_prim<a, e>(s: Scope, f: () -> a with Async | e) -> Unit = primop FiberForkScoped

    /// Cancel all fibers forked under scope `s` (proposal 0174 1b-vi-c).
    intrinsic fn fiber_cancel_scope_prim(s: Scope) -> Unit = primop FiberCancelScope

    // ── Runtime configuration (Phase 2 slice 2-vii) ───────────────────

    /// Knobs passed to `Async.run_async_with` to override scheduler /
    /// blocking-pool defaults for a single `run_async` boundary.
    ///
    /// Field semantics:
    ///
    /// - `worker_count`: `Some(n)` requests `n` worker workers (>= 1).
    ///   `None` means "use the runtime default" — `available_parallelism()`
    ///   on platforms that report it, falling back to 2 logical workers
    ///   on the VM. Honored on the VM today; the native runtime currently
    ///   uses its compile-time `LOGICAL_WORKERS` constant and ignores
    ///   this field (full native support is a follow-up).
    /// - `fs_pool_size`: blocking-thread pool size for filesystem ops.
    ///   Accepted today and stored, but only consulted once Phase 2
    ///   slice 2-viii lands the blocking pool. `0` means "use default".
    /// - `dns_pool_size`: blocking-thread pool size for DNS resolution.
    ///   Same status as `fs_pool_size`.
    public data RuntimeConfig {
        RuntimeConfig {
            worker_count:  Option<Int>,
            fs_pool_size:  Int,
            dns_pool_size: Int,
        }
    }

    /// Construct a `RuntimeConfig` with all defaults.
    ///
    /// `run_async(action)` is equivalent to
    /// `run_async_with(default_runtime_config(), action)`.
    /// Env-var fallbacks (`FLUX_WORKERS`, `FLUX_FS_THREADS`,
    /// `FLUX_DNS_THREADS`) are read by the runtime when the corresponding
    /// field is the default sentinel; an explicit `RuntimeConfig` override
    /// always wins.
    public fn default_runtime_config() -> RuntimeConfig {
        RuntimeConfig {
            worker_count:  None,
            fs_pool_size:  0,
            dns_pool_size: 0,
        }
    }

    /// Builder helper: a `RuntimeConfig` with `worker_count = Some(n)` and
    /// defaults elsewhere. Convenient for the common case of pinning the
    /// scheduler to a specific worker count without spelling out the full
    /// record literal at the call site.
    public fn with_worker_count(n: Int) -> RuntimeConfig {
        RuntimeConfig {
            worker_count:  Some(n),
            fs_pool_size:  0,
            dns_pool_size: 0,
        }
    }

    // ── Entry point ───────────────────────────────────────────────────

    /// Run an async computation. This is the boundary that installs the
    /// `Async` effect handler. Blocks the calling OS thread until the
    /// root fiber completes.
    public fn run_async<a>(action: () -> a with Async) -> a {
        fiber_run_async(action)
    }

    /// Run an async computation with explicit `RuntimeConfig` knobs.
    /// See [`RuntimeConfig`] for field semantics. `worker_count == None`
    /// is encoded as the sentinel `0` in the primop call so the runtime
    /// can choose its default.
    public fn run_async_with<a>(cfg: RuntimeConfig, action: () -> a with Async) -> a {
        let workers = match cfg.worker_count {
            Some(n) -> n,
            None    -> 0
        }
        fiber_run_async_with_prim(workers, cfg.fs_pool_size, cfg.dns_pool_size, action)
    }

    // ── Structured concurrency ────────────────────────────────────────

    /// Establish a cancellation boundary.
    ///
    /// Allocates a fresh scope ID and passes it to `f`. Any fibers forked
    /// inside `f` via `fork(s, ...)` are registered under this scope and can
    /// be cancelled together via `cancel(s)`.
    public fn scope<a>(f: (Scope) -> a with Async) -> a with Async {
        let s = fiber_new_scope_prim()
        f(s)
    }

    /// Fork a child fiber attached to `s`.
    ///
    /// The child is registered under the scope so `cancel(s)` can stop it.
    public fn fork<a>(s: Scope, f: () -> a with Async) -> Unit with Async {
        fiber_fork_scoped_prim(s, f)
    }

    /// Cancel all fibers forked under scope `s`.
    ///
    /// Each registered fiber is cancelled: its pending backend request is
    /// stopped and its continuation is resumed with `AsyncError.Canceled`
    /// so that `bracket`/`finally` cleanup arms run.
    public fn cancel(s: Scope) -> Unit with Async {
        fiber_cancel_scope_prim(s)
    }

    /// Run `f` and `g` concurrently; return both results.
    ///
    /// VM: real concurrent execution via the fiber scheduler — `f` and `g`
    /// run interleaved on a single OS thread. Native: 1b-vi-d.
    ///
    /// Parser limitation (Phase 1b): only the last callback parameter may carry
    /// `with Async`. Pass named `with Async` functions for both arguments; the
    /// effect is inferred at the call site.
    public fn both<a, b>(f: (() -> a with Async | e1), g: (() -> b with Async | e2)) -> (a, b) with Async {
        fiber_both_prim(f, g)
    }

    /// Run `f` and `g` concurrently; return whichever finishes first.
    ///
    /// VM: real first-wins via the fiber scheduler. Loser keeps running
    /// until completion (cancellation lands in 1b-vi-c).
    ///
    /// Parser limitation (Phase 1b): pass named `with Async` functions for both args.
    public fn race<a>(f: (() -> a with Async | e1), g: (() -> a with Async | e2)) -> a with Async {
        fiber_race_prim(f, g)
    }

    /// Bound `f` by `ms` milliseconds. Returns `Some(v)` or `None`.
    ///
    /// VM: always returns `Some(f())`.
    public fn timeout<a>(ms: Int, f: () -> a with Async) -> Option<a> with Async {
        fiber_timeout_prim(ms, f)
    }

    /// Like `timeout` but preserves the error channel.
    ///
    /// VM: real overlap via fiber scheduler — same shape as `timeout`.
    public fn timeout_result<a>(ms: Int, f: () -> a with Async) -> Option<a> with Async {
        fiber_timeout_prim(ms, f)
    }

    /// Run `body`; always run `cleanup` afterward.
    ///
    /// VM: runs `body`, then `cleanup`, returns body's result.
    ///
    /// Parser limitation (Phase 1b): `cleanup` may carry `with Async`; `body` is unannotated.
    public fn finally<a>(body: () -> a, cleanup: () -> Unit with Async) -> a with Async {
        let result = body()
        let _ = cleanup()
        result
    }

    /// Acquire a resource, run `body`, then always call `release`.
    ///
    /// VM: acquire → body → release, sequentially.
    ///
    /// Parser limitation (Phase 1b): only `body` may carry `with Async`.
    public fn bracket<r, c, a>(acquire: () -> r, release: (r) -> c, body: (r) -> a with Async) -> a with Async {
        let resource = acquire()
        let result = body(resource)
        let _ = release(resource)
        result
    }

    /// Catch errors in `body` and return as `None`.
    ///
    /// VM: returns `Some(body())`.
    public fn try_<a>(body: () -> a with Async) -> Option<a> with Async {
        Some(body())
    }

    /// Raise an `AsyncError` inside the current fiber.
    public fn fail<a>(err: AsyncError) -> a with Async {
        fiber_fail_prim(err)
    }

    // ── Scheduling primitives ─────────────────────────────────────────

    /// Yield the current fiber to the scheduler.
    ///
    /// VM: no-op.
    public fn yield_now() -> Unit with Async {
        fiber_yield_now_prim()
    }

    /// True iff the enclosing `Async.scope` (or `timeout` / `race`) has
    /// been cancelled. Fibers in long pure loops between `await` points
    /// should call this periodically and `return` early when it returns
    /// true.
    ///
    /// `Async.yield_now()` is **not** yet a cancellation point on its
    /// own — that comes in slice 2-vi together with the real
    /// `Async.fail` raise machinery. Until then, pair this with an
    /// explicit `return` or use `bail_if_cancelled` for the common
    /// raise-and-unwind shape (see proposal 0174 slice 2-iv).
    public fn check_cancelled() -> Bool with Async {
        fiber_check_cancelled_prim()
    }

    /// Convenience wrapper: `if check_cancelled() { fail(AsyncError.Canceled) }`.
    /// Until slice 2-vi makes `fail` a catchable raise, this aborts the
    /// fiber via the existing soft-cancel path (today: VM `Err` string,
    /// caught at the `run_async` boundary).
    public fn bail_if_cancelled() -> Unit with Async {
        if check_cancelled() { fail(Canceled) }
        else { () };
    }

    /// Suspend the current fiber for at least `ms` milliseconds.
    ///
    /// VM: blocks the calling OS thread.
    public fn sleep(ms: Int) -> Unit with Async {
        fiber_sleep_prim(ms)
    }
}
