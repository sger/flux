// parity: vm, llvm
// expect: success
// bug: a user function named after a prelude class method failed to compile
//      whenever the standard-library modules were compiled rather than loaded
//      from cache — `flux --no-cache file.flx`, and every parity way that
//      passes `--no-cache`:
//
//        error[E001]: Duplicate Name
//        Duplicate binding: `add` is already defined.
//
//      Proposal 0179 Stage 8 moved `Eq`, `Num`, `Show` and friends into Flux
//      modules. Compiling one of those modules generates a polymorphic
//      dispatch stub under the bare method name, and a single `Compiler`
//      compiles every module of a program, so the stub was still defined when
//      the user's own `fn add` was declared. A stub is not a user declaration
//      and a real function takes precedence over it, which is already the
//      resolution rule: a name bound to a function never dispatches as a
//      class method.

fn add(x: Int, y: Int) -> Int { x + y }
fn eq(x: Int, y: Int) -> Bool { x == y }
fn show(x: Int) -> Int { x * 2 }
fn lt(x: Int, y: Int) -> Bool { x > y }
fn append(x: Int, y: Int) -> Int { x - y }
fn compare(x: Int, y: Int) -> Int { x + y + 1 }

fn main() with IO {
    print(add(3, 4))
    print(eq(1, 1))
    print(show(21))
    print(lt(1, 2))
    print(append(9, 4))
    print(compare(1, 2))
}
