// Debug parity (0188 S7): a panic stops where it happens, then ends the
// program.
// dbg: continue
// dbg: bt
// dbg: continue

fn check(n: Int) -> Int {
    if n > 2 {
        panic("too big")
    } else {
        n
    }
}

fn total(xs: List<Int>) -> Int {
    let n = check(len(xs))
    n + 1
}

fn main() with IO {
    let xs = [1, 2, 3]
    print(to_string(total(xs)))
}
