// Flow.Async — structured concurrency primitives (proposal 0174 Phase 1b).
//
// All functions in this module require the `Async` effect, which expands to
// `<Suspend | Fork | GetContext | AsyncFail>`. These four seam labels are
// compiler-seeded in `src/syntax/builtin_effects.rs` and routed to the fiber
// scheduler in `src/runtime/async/scheduler.rs`.
//
// **Phase 1b status:** function bodies below call fiber runtime primops that
// land in Slice 1b-v/vi. Until those primops are wired, calling these
// functions panics with a "not yet implemented" message. The type surface is
// fixed — code written against this API requires no changes once the runtime
// lands.
//
// The three-effect seam pattern follows OCaml/Eio's design
// (lib_eio/core/eio__core.ml). `Suspend` / `Fork` / `GetContext` are
// implementation detail; user code writes `with Async`.

module Flow.Async {

    // ── Error type ────────────────────────────────────────────────────

    /// Errors that may be raised by async operations.
    public data AsyncError {
        /// The enclosing scope was cancelled before this fiber completed.
        Canceled,
        /// A `timeout` or `timeout_result` deadline expired.
        TimedOut,
        /// TCP / UDP I/O failure. Fields: (errno, message, syscall).
        IoError(Int, String, String),
        /// DNS resolution failure. Fields: (code, message, host).
        DnsError(Int, String, String),
        /// The remote peer closed the connection.
        ConnectionClosed,
        /// Address could not be parsed.
        InvalidAddress(String),
    }

    // ── Structural handles ────────────────────────────────────────────

    /// Cancellation boundary. Fibers forked inside a `scope` call are
    /// attached to the `Scope` value; cancelling the scope cancels all
    /// of them.
    public data Scope { Scope(Int) }

    /// Opaque fiber identifier. Used internally by the setup-closure
    /// pattern to route completions back to the correct suspended fiber.
    public data FiberId { FiberId(Int) }

    /// Handle returned by an async operation registration, used by the
    /// scheduler to cancel the operation if the enclosing scope is
    /// cancelled before the operation completes.
    public data CancelHandle { CancelHandle(Int) }

    // ── Entry point ───────────────────────────────────────────────────

    /// Run an async computation on the fiber scheduler. This is the
    /// boundary that installs the `Async` effect handler. Blocks the
    /// calling OS thread until the root fiber completes.
    ///
    /// Typical top-level usage:
    ///   fn main() { Async.run_async(fn() { ... }) }
    public fn run_async<a>(action: () -> a with Async) -> a {
        // Phase 1b-vi: replaced with fiber_run_async primop.
        panic("Async.run_async: fiber scheduler not yet wired (proposal 0174 Phase 1b-vi)")
    }

    // ── Structured concurrency ────────────────────────────────────────

    /// Establish a cancellation boundary. Forked child fibers that are
    /// still running when `f` returns are cancelled and joined before
    /// `scope` returns.
    public fn scope<a>(f: (Scope) -> a with Async) -> a with Async {
        panic("Async.scope: not yet implemented (proposal 0174 Phase 1b-vi)")
    }

    /// Fork a child fiber attached to `s`. The child runs concurrently
    /// with the caller; its result is discarded (use `both` or channels
    /// for result collection). The child is cancelled when `s` is
    /// cancelled or when the enclosing `scope` block exits.
    public fn fork(s: Scope, f: () -> Unit with Async) -> Unit with Async {
        panic("Async.fork: not yet implemented (proposal 0174 Phase 1b-vi)")
    }

    /// Run `f` and `g` concurrently; return both results. If either
    /// raises, the other is cancelled and the error is re-raised.
    public fn both<a, b>(f: () -> a with Async, g: () -> b with Async) -> (a, b) with Async {
        panic("Async.both: not yet implemented (proposal 0174 Phase 1b-vi)")
    }

    /// Run `f` and `g` concurrently; return whichever finishes first and
    /// cancel the other.
    public fn race<a>(f: () -> a with Async, g: () -> a with Async) -> a with Async {
        panic("Async.race: not yet implemented (proposal 0174 Phase 1b-vi)")
    }

    /// Bound `f` by `ms` milliseconds. Returns `Some(v)` if `f` completes
    /// in time, `None` if the deadline expires (the fiber is cancelled).
    public fn timeout<a>(ms: Int, f: () -> a with Async) -> Option<a> with Async {
        panic("Async.timeout: not yet implemented (proposal 0174 Phase 1b-vi)")
    }

    /// Like `timeout` but keeps the error channel: returns `Ok(v)` or
    /// `Err(AsyncError.TimedOut)`.
    public fn timeout_result<a>(ms: Int, f: () -> a with Async) -> Option<a> with Async {
        panic("Async.timeout_result: not yet implemented (proposal 0174 Phase 1b-vi)")
    }

    /// Run `body`; always run `cleanup` afterward, even if `body` raises.
    /// The return value of `cleanup` is discarded.
    public fn finally<a>(body: () -> a with Async, cleanup: () -> Unit with Async) -> a with Async {
        panic("Async.finally: not yet implemented (proposal 0174 Phase 1b-vi)")
    }

    /// Acquire a resource, run `body`, then always call `release` —
    /// even if `body` raises or the scope is cancelled.
    public fn bracket<r, a>(
        acquire: () -> r with Async,
        release: (r) -> Unit with Async,
        body: (r) -> a with Async
    ) -> a with Async {
        panic("Async.bracket: not yet implemented (proposal 0174 Phase 1b-vi)")
    }

    /// Catch `AsyncError` raised inside `body` and return it as `Err`.
    public fn try_<a>(body: () -> a with Async) -> Option<a> with Async {
        panic("Async.try_: not yet implemented (proposal 0174 Phase 1b-vi)")
    }

    /// Raise an `AsyncError` inside the current fiber.
    public fn fail<a>(err: AsyncError) -> a with Async {
        panic("Async.fail: not yet implemented (proposal 0174 Phase 1b-vi)")
    }

    // ── Scheduling primitives ─────────────────────────────────────────

    /// Yield the current fiber to the scheduler, allowing other ready
    /// fibers to run before this one resumes.
    public fn yield_now() with Async {
        panic("Async.yield_now: not yet implemented (proposal 0174 Phase 1b-vi)")
    }

    /// Suspend the current fiber for at least `ms` milliseconds.
    public fn sleep(ms: Int) with Async {
        panic("Async.sleep: not yet implemented (proposal 0174 Phase 1b-vi)")
    }
}
