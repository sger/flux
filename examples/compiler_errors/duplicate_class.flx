// expect: compile_error
// expect-error: E440
// NOTE: `collect_class_declarations` routes E440 into the warning half of its
// partition (src/compiler/mod.rs); a later stage still rejects the program, so
// `flux` reports E440 and exits 1. The snapshot harness stops before that stage.

// Defining the same type class twice.
//
// One E440, not two. The stdlib's `Show` lives in `Flow.Show` since Proposal
// 0179 Stage 8, so the first declaration below shadows an imported class
// rather than colliding with a compiler-owned one; only the second is a
// redeclaration within this module.
//
// Expected: E440 Duplicate Type Class
//   "Type class `Show` is already defined."
//   Hint: "Each type class name must be unique."

class Show<a> {
    fn show(x: a) -> Int
}

class Show<a> {
    fn show(x: a) -> Int
}

fn main() {
    42
}
