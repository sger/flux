// parity: vm, llvm
// expect: success
// bug: try(body) must return Ok(body()) when no async error is raised.
// parity-expected-stdout-begin
// Ok(42)
// parity-expected-stdout-end

import Flow.Async exposing (..)

fn inner() -> Int with Async { 42 }

fn body() with Async {
    try(inner)
}

fn main() with IO {
    print(run_async(body))
}
