// Debug parity (0188 S8): fibers as threads. A stop in one child of `both`
// lists every fiber with what it waits for, and a parked fiber's stack is
// the frames its continuation holds.
// dbg: break 22
// dbg: continue
// dbg: threads
// dbg: bt
// dbg: locals
// dbg: thread 2
// dbg: bt
// dbg: continue

import Flow.Async exposing (..)

fn slow() -> Int with Async {
    sleep(20)
    let m = 3 * 2
    m + 1
}

fn fast() -> Int with Async {
    let k = 4 + 1
    k * 10
}

fn body() -> String with Async {
    let pair = both(slow, fast)
    to_string(pair.0) + "," + to_string(pair.1)
}

fn main() with IO {
    print(run_async(body))
}

// dbg-check: stop fast async_both.flx:22 thread 3
// dbg-check: thread 1 main [waiting both (threads 2, 3)] async_both.flx:27
// dbg-check: thread 2 slow [waiting sleep 20 ms] async_both.flx:16
// dbg-check: thread 3 fast [stopped] async_both.flx:22
// dbg-check: frame fast async_both.flx:22
// dbg-check: no variables
// dbg-check: frame slow async_both.flx:16
// dbg-check: finished
