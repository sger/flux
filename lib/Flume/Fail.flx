/// Abort with a message, instead of threading `Result` by hand.
///
/// A fallible read becomes an ordinary `let`, and the failure surfaces at the
/// handler rather than at every call site:
///
/// ```flux
/// fn entry(fields: Fields) -> Entry with Fail {
///     let name = Fail.require_string(fields, "name")
///     let version = Fail.require_version(fields, "version")
///     Entry { name: name, version: version }
/// }
///
/// // Result appears once, at the boundary:
/// wrap(fields) handle Fail { fail(resume, message) -> Err(message) }
/// ```
///
/// The handler must scope a call directly. `Ok(f(x)) handle Fail { .. }` does
/// not install the handler over `f`.
module Flume.Fail {

    effect Fail {
        fail: String -> Unit
    }

    /// Abort with `message`.
    ///
    /// Returns `a` so it can stand in any position; the handler never resumes,
    /// so the returned value is unreachable.
    public fn abort<a>(message: String, unreachable: a) -> a with Fail {
        perform Fail.fail(message)
        unreachable
    }

    /// Abort unless `ok`.
    ///
    /// Returns `Bool` rather than `Unit` so the body is an ordinary
    /// expression; callers discard it.
    public fn require(ok: Bool, message: String) -> Bool with Fail {
        if ok { true } else { abort(message, false) }
    }

    /// The value, or abort with `message`.
    public fn expect<a>(value: Option<a>, message: String, fallback: a) -> a with Fail {
        match value {
            Some(found) -> found,
            None -> abort(message, fallback),
        }
    }

    /// The `Ok` value, or abort with the `Err` as the message.
    public fn ok_or_abort<a>(result: Result<a, String>, fallback: a) -> a with Fail {
        match result {
            Ok(found) -> found,
            Err(message) -> abort(message, fallback),
        }
    }
}
