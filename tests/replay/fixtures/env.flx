// Environment reads are inputs: replay returns what the recorded run saw.
import Flow.Env as Env

fn main() with IO {
    println(Env.var_or("REPLAY_FIXTURE_VAR", "unset"))
    println(Env.has_var("REPLAY_FIXTURE_ABSENT"))
    println(Env.args())
    match Env.cwd() {
        Ok(dir) -> println(len(dir) > 0),
        Err(_) -> println("no cwd"),
    }
    match Env.home_dir() {
        Some(dir) -> println(len(dir) > 0),
        None -> println("no home"),
    }
}
