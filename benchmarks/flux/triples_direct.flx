// triples without effects: the same triples i > j > k, visited in the same
// order, their hashes added mod 1000000007 as they are found.
import Flow.Env as Env
import Flow.Array as Array

fn hash(i: Int, j: Int, k: Int) -> Int {
    (53 * i + 2809 * j + 148877 * k) % 1000000007
}

fn ks(i: Int, j: Int, k: Int, s: Int, acc: Int) -> Int {
    if k < 1 { acc } else {
        ks(i, j, k - 1, s, if i + j + k == s { (acc + hash(i, j, k)) % 1000000007 } else { acc })
    }
}

fn js(i: Int, j: Int, s: Int, acc: Int) -> Int {
    if j < 1 { acc } else { js(i, j - 1, s, ks(i, j, j - 1, s, acc)) }
}

fn is(i: Int, s: Int, acc: Int) -> Int {
    if i < 1 { acc } else { is(i - 1, s, js(i, i - 1, s, acc)) }
}

// The workload size: the program's first argument, or the size the suite
// was written with. `cargo xtask bench` passes a smaller one to the VM.
fn size(default: Int) -> Int with Env {
    match Array.get(Env.args(), 1) {
        Some(s) -> parse_int(s),
        None -> default,
    }
}

fn main() with IO {
    let n = size(10)
    print(is(n, n, 0))
}
