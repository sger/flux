{
  "name": "flux-language",
  "displayName": "Flux Language Support",
  "description": "Syntax highlighting, language server integration and a debugger for the Flux language.",
  "version": "0.0.6",
  "publisher": "flux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sger/flux.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:flux",
    "onDebugResolve:flux",
    "onDebugDynamicConfigurations:flux",
    "onDebugInitialConfigurations"
  ],
  "contributes": {
    "languages": [
      {
        "id": "flux",
        "aliases": [
          "Flux",
          "flux"
        ],
        "extensions": [
          ".flx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "flux.viewTokens",
        "title": "Flux: View Tokens",
        "category": "Flux"
      },
      {
        "command": "flux.viewCoreIr",
        "title": "Flux: View Core IR",
        "category": "Flux"
      },
      {
        "command": "flux.viewBytecode",
        "title": "Flux: View Bytecode",
        "category": "Flux"
      },
      {
        "command": "flux.restartServer",
        "title": "Flux: Restart Language Server",
        "category": "Flux"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "flux.viewTokens",
          "when": "editorLangId == flux"
        },
        {
          "command": "flux.viewCoreIr",
          "when": "editorLangId == flux"
        },
        {
          "command": "flux.viewBytecode",
          "when": "editorLangId == flux"
        },
        {
          "command": "flux.restartServer",
          "when": "editorLangId == flux"
        }
      ]
    },
    "grammars": [
      {
        "language": "flux",
        "scopeName": "source.flux",
        "path": "./syntaxes/flux.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Flux",
      "properties": {
        "flux.serverPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the flux-lsp binary. Leave empty to use the binary bundled with this extension."
        },
        "flux.runCommand": {
          "type": "string",
          "default": "cargo run --",
          "description": "Base command the ▶ Run / ▶ Run Test code lenses launch in a terminal (with the file path, plus --test --test-filter <name> for tests). The ▶ Eval lens reuses it as a captured subprocess: `<runCommand> eval \"<expr>\"`."
        },
        "flux.workspaceDiagnostics.scanAllFiles": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Report `workspace/diagnostic` problems for **every** `.flx` file in the workspace, not just open files and the modules they import. Surfaces all project-wide errors at once, but in a repository with examples or fixtures that fail by design it will flag those too (and tint their folders red in the Explorer). Changing this restarts the language server."
        },
        "flux.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP messages between VS Code and flux-lsp."
        },
        "flux.dapPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the flux-dap binary that runs debug sessions. Leave empty to use the binary bundled with this extension, or `flux-dap` on PATH."
        },
        "flux.lldbDapPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `lldb-dap`, which native debug sessions (`\"backend\": \"native\"`) run on. Leave empty to use `lldb-dap` (or `lldb-dap-18` and later) on PATH, or Xcode's on macOS."
        }
      }
    },
    "configurationDefaults": {
      "[flux]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenScopes": [
      {
        "language": "flux",
        "scopes": {
          "namespace": [
            "entity.name.namespace.flux",
            "entity.name.type.flux"
          ],
          "type": [
            "entity.name.type.flux"
          ],
          "class": [
            "entity.name.type.class.flux",
            "entity.name.type.flux"
          ],
          "enum": [
            "entity.name.type.enum.flux",
            "entity.name.type.flux"
          ],
          "interface": [
            "entity.name.type.interface.flux",
            "entity.name.type.flux"
          ],
          "typeParameter": [
            "entity.name.type.parameter.flux",
            "entity.name.type.flux"
          ],
          "parameter": [
            "variable.parameter.flux"
          ],
          "variable": [
            "variable.other.flux"
          ],
          "property": [
            "variable.other.property.flux"
          ],
          "enumMember": [
            "variable.other.enummember.flux",
            "support.type.variant.flux"
          ],
          "function": [
            "entity.name.function.flux"
          ],
          "method": [
            "entity.name.function.member.flux",
            "entity.name.function.flux"
          ],
          "keyword": [
            "keyword.flux"
          ],
          "comment": [
            "comment.flux"
          ],
          "string": [
            "string.flux"
          ],
          "number": [
            "constant.numeric.flux"
          ],
          "operator": [
            "keyword.operator.flux"
          ],
          "decorator": [
            "entity.name.type.flux"
          ]
        }
      }
    ],
    "breakpoints": [
      {
        "language": "flux"
      }
    ],
    "debuggers": [
      {
        "type": "flux",
        "label": "Flux",
        "languages": [
          "flux"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .flx file to debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory. Defaults to the program's folder."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the program's first line.",
                "default": false
              },
              "showInternals": {
                "type": "boolean",
                "description": "Show compiler-made frames and variables, such as type-class dictionaries.",
                "default": false
              },
              "backend": {
                "type": "string",
                "enum": [
                  "vm",
                  "native"
                ],
                "markdownDescription": "Which backend runs the program. `vm` can also step back and replay. `native` builds the program with `--native -g` and runs it under `lldb-dap`; its `flux` command must have the native backend (built with `--features llvm`).",
                "default": "vm"
              },
              "lldbDap": {
                "type": "string",
                "description": "For the native backend: the lldb-dap to run. Defaults to the `flux.lldbDapPath` setting."
              },
              "record": {
                "type": "string",
                "description": "Also write the run's effects to this tape file (`--record`)."
              },
              "replay": {
                "type": "string",
                "description": "Replay this tape instead of performing effects (`--replay`): inputs come from the recording."
              },
              "fluxCommand": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The command that runs `flux`, such as [\"flux\"] or [\"cargo\", \"run\", \"--\"]. Defaults to the `flux.runCommand` setting."
              },
              "fluxArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Options for `flux` itself, such as [\"--no-cache\"].",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "flux",
            "request": "launch",
            "name": "Debug current Flux file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Flux: Debug a file",
            "description": "Debug a Flux program on the VM.",
            "body": {
              "type": "flux",
              "request": "launch",
              "name": "Debug ${1:program}",
              "program": "^\"\\${workspaceFolder}/${1:main.flx}\""
            }
          },
          {
            "label": "Flux: Debug a native build",
            "description": "Build the program with --native -g and debug it under lldb-dap.",
            "body": {
              "type": "flux",
              "request": "launch",
              "name": "Debug ${1:program} (native)",
              "program": "^\"\\${workspaceFolder}/${1:main.flx}\"",
              "backend": "native"
            }
          },
          {
            "label": "Flux: Debug a recorded run",
            "description": "Replay a tape under the debugger; Step Back and Reverse Continue work through it.",
            "body": {
              "type": "flux",
              "request": "launch",
              "name": "Replay ${1:program}",
              "program": "^\"\\${workspaceFolder}/${1:main.flx}\"",
              "replay": "^\"\\${workspaceFolder}/${2:run.flxtape}\""
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}
