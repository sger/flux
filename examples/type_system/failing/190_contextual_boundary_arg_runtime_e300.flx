// parity-expected-stdout-begin
// parity-expected-stdout-end
// root: examples/type_system
// expect: compile_error

// E300: a module-qualified dynamic value passed to a typed argument is caught
// at compile time, before the runtime boundary check (E1004).

import TypeSystem.BoundaryUnknown

fn typed_add(a: Int, b: Int) -> Int {
    a + b
}

let dynamic = TypeSystem.BoundaryUnknown.dynamic_string()
typed_add(dynamic, 1) //~ E300
