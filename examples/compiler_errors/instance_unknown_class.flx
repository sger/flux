// expect: compile_error
// expect-error: E441
// NOTE: `collect_class_declarations` routes E441 into the warning half of its
// partition (src/compiler/mod.rs); a later stage still rejects the program, so
// `flux` reports E441 and exits 1. The snapshot harness stops before that stage.

// Instance declaration for a class that doesn't exist.
//
// Expected: E441 Unknown Type Class
//   "No type class `Foo` is defined."
//   Hint: "Declare the class first: `class Foo<a> { ... }`"

instance Foo<Int> {
    fn bar(x) { x }
}

fn main() {
    42
}
