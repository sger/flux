// Debug parity: a lambda's parameters and what it captures.
// dbg: break 14
// dbg: continue
// dbg: locals
// dbg: bt
// dbg: continue
// dbg: locals
// dbg: delete 14
// dbg: continue

fn main() {
    let offset = 10
    let shifted = map([1, 2], \x -> {
        let moved = x + offset
        moved
    })
    print(shifted)
    print(offset)
}

// dbg-check: stop <lambda closures.flx:13:31> closures.flx:14
// dbg-check: offset = 10 (captured)
// dbg-check: x = 1
// dbg-check: frame <lambda closures.flx:13:31> closures.flx:14
// dbg-check: frame <library>
// dbg-check: frame main closures.flx:13
// dbg-check: stop <lambda closures.flx:13:31> closures.flx:14
// dbg-check: offset = 10 (captured)
// dbg-check: x = 2
// dbg-check: finished
