// parity: vm, llvm
// expect: success
// bug: yield_now must be a no-op on the VM sequential path and must not
//      interfere with surrounding computation.

import Flow.Async exposing (..)

fn body() -> Int with Async {
    yield_now()
    7
}

fn main() with IO {
    let v = run_async(body)
    print(v)
}
