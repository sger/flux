// parity: vm, llvm
// parity-expected-stdout-begin
// 99
// parity-expected-stdout-end
//
// CML-style `with_nack`: when the branch built by the callback *loses* the
// enclosing `choose`, its nack event fires (proposal 0177 T2.5). Here the
// `win` branch (ready immediately) beats the `with_nack` branch (a 10s timer),
// so the nack fires; a forked cleanup fiber blocked on `sync(nack)` wakes and
// records the sentinel 99.
import Flow.Async exposing (..)
import Flow.Channel as Channel
import Flow.Event exposing (..)

fn loss_case() -> Int with Async {
    let obs: Channel<Int> = Channel.make(4)
    scope(fn(s) with Async {
        let win: Event<Unit> = wrap(always(0), fn(_) { })
        let nb: Event<Unit> = with_nack(fn(nack) with Async {
            let _u = fork(s, fn() with Async {
                let _r = sync(nack)
                let _s2 = Channel.try_send(obs, 99)
                0
            })
            wrap(after(10000), fn(_) { })
        })
        let _w = sync(choose([win, nb]))
        yield_now()
        yield_now()
        match Channel.try_recv(obs) { Some(n) -> n, None -> 0 }
    })
}

fn main() with IO { print(run_async(loss_case)) }
