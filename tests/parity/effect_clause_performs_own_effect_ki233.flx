// parity: vm, llvm
// expect: success
// bug: KI-233. A clause ran under its own handler, so a clause that
//      performs its own effect, here to forward to the outer Ask handler as
//      handler_sieve does, reached itself again: a stack overflow on the VM,
//      a hang natively, and then a compile-time rejection. A clause runs
//      outside its handler, so the perform reaches the outer one.
// parity-expected-stdout-begin
// 101
// parity-expected-stdout-end

effect Ask {
    ask : () -> Int
}

fn asks() -> Int with Ask {
    perform Ask.ask()
}

fn inner() -> Int with Ask {
    asks() handle Ask { ask(resume) -> resume(perform Ask.ask() + 1) }
}

fn main() with IO {
    print(inner() handle Ask { ask(resume) -> resume(100) })
}
