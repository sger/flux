/// Total ordering.
///
/// `<`, `<=`, `>` and `>=` desugar to `lt`, `lte`, `gt` and `gte`. `compare`
/// returns `-1`, `0` or `1`. As with `Eq`, a concrete primitive's operator
/// lowers to a primop, so the instances below do not recurse.
///
/// `Eq` is a superclass: every ordered type is an equatable one, so a
/// function constrained by `Ord` alone can still call `eq` and `neq`, reached
/// through the evidence slot that leads every `Ord` dictionary. Each instance
/// names that evidence explicitly (`Eq<Int> => Ord<Int>`); leaving it to be
/// solved from `Flow.Eq` instead sends the solver into a loop that overflows
/// the compiler's stack. (Proposal 0179 Stage 8.)
import Flow.Eq

module Flow.Ord {
    public class Eq<a> => Ord<a> {
        fn compare(x: a, y: a) -> Int
        fn lt(x: a, y: a) -> Bool
        fn lte(x: a, y: a) -> Bool
        fn gt(x: a, y: a) -> Bool
        fn gte(x: a, y: a) -> Bool
    }

    public instance Eq<Int> => Ord<Int> {
        fn compare(x, y) { if x < y { -1 } else { if x > y { 1 } else { 0 } } }
        fn lt(x, y) { x < y }
        fn lte(x, y) { x <= y }
        fn gt(x, y) { x > y }
        fn gte(x, y) { x >= y }
    }

    public instance Eq<Float> => Ord<Float> {
        fn compare(x, y) { if x < y { -1 } else { if x > y { 1 } else { 0 } } }
        fn lt(x, y) { x < y }
        fn lte(x, y) { x <= y }
        fn gt(x, y) { x > y }
        fn gte(x, y) { x >= y }
    }

    public instance Eq<String> => Ord<String> {
        fn compare(x, y) { if x < y { -1 } else { if x > y { 1 } else { 0 } } }
        fn lt(x, y) { x < y }
        fn lte(x, y) { x <= y }
        fn gt(x, y) { x > y }
        fn gte(x, y) { x >= y }
    }
}
