// parity-expected-stdout-begin
// 3
// 2
// parity-expected-stdout-end

// A recursive parameterized ADT, and a generic function over it.
//
// `Tree<a>` refers to itself in its own variant, and `depth` is written once
// and used at `Tree<Int>` and `Tree<String>`. The element type never appears in
// `depth`'s body — only the shape does — which is what makes one definition
// serve both.

data Tree<a> {
    Leaf(a),
    Node(Tree<a>, Tree<a>),
}

fn larger(a: Int, b: Int) -> Int {
    if a >= b { a } else { b }
}

fn depth<a>(t: Tree<a>) -> Int {
    match t {
        Leaf(_) -> 1,
        Node(l, r) -> larger(depth(l), depth(r)) + 1,
    }
}

fn main() with IO {
    let numbers = Node(Leaf(1), Node(Leaf(2), Leaf(3)))
    let words = Node(Leaf("a"), Leaf("b"))
    print(depth(numbers))
    print(depth(words))
}
