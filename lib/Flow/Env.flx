// Flow.Env — the process environment.
//
// Reading the environment is ambient input: it makes a function
// non-deterministic in exactly the way filesystem access does, so it carries
// its own `Env` effect rather than being invisible. A function that consults
// `$HOME` says so in its signature.
//
// `Env` coarsens to `IO`, alongside `Console`, `FileSystem`, and `Stdin`.
//
// Note the return types differ deliberately. An unset variable is an ordinary
// condition, so `var` and `home_dir` return `Option`. A missing working
// directory is a genuine failure — it can be deleted out from under a running
// process — so `cwd` returns `Result`.

import Flow.IoError as IoError
import Flow.Result as Result

module Flow.Env {

    intrinsic fn env_args_prim() -> Array<String> with Env = primop EnvArgs

    /// The program's arguments, with the script path first.
    ///
    /// The leading element is the program's own name, matching `argv[0]`
    /// everywhere else, so a tool can print its name in its usage text. Use
    /// `Flow.Array.drop(args(), 1)` for just the user-supplied arguments.
    ///
    /// On the command line, arguments reach the program after a `--`:
    ///
    /// ```text
    /// flux run build.flx -- --target native -v
    /// ```
    ///
    /// The separator is what lets a Flux program accept flags that `flux`
    /// itself would otherwise claim or reject.
    public fn args() -> Array<String> with Env {
        env_args_prim()
    }

    intrinsic fn env_var_prim(name: String) -> Option<String> with Env = primop EnvVar

    /// The value of an environment variable, or `None` when it is unset.
    ///
    /// `None` also covers a variable whose value is not valid text: either
    /// way there is no usable value, and distinguishing them would put a
    /// platform detail in the caller's path.
    public fn var(name: String) -> Option<String> with Env {
        env_var_prim(name)
    }

    /// The value of an environment variable, or `fallback` when unset.
    ///
    /// The common shape for optional configuration, where the distinction
    /// between unset and empty does not matter.
    public fn var_or(name: String, fallback: String) -> String with Env {
        match var(name) {
            Some(value) -> value,
            None -> fallback,
        }
    }

    /// Whether an environment variable is set at all.
    ///
    /// Useful for the flag-style variables whose value is irrelevant — only
    /// their presence matters.
    public fn has_var(name: String) -> Bool with Env {
        match var(name) {
            Some(_) -> true,
            None -> false,
        }
    }

    intrinsic fn env_cwd_prim() -> Result<String, IoError> with Env = primop EnvCwd

    /// The current working directory.
    ///
    /// Fallible rather than `Option`: the directory can be removed while the
    /// process is still running in it, and that is a real error worth
    /// reporting rather than an ordinary absence.
    public fn cwd() -> Result<String, IoError> with Env {
        env_cwd_prim()
    }

    intrinsic fn env_home_dir_prim() -> Option<String> with Env = primop EnvHomeDir

    /// The user's home directory, or `None` when the platform does not say.
    ///
    /// Read from the environment (`HOME`, or `USERPROFILE` on Windows) rather
    /// than the password database, so a user who overrides it is honoured.
    public fn home_dir() -> Option<String> with Env {
        env_home_dir_prim()
    }
}
