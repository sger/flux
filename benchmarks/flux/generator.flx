// effect-handlers-bench's generator: a tree of height n, whose subtrees are
// shared, is walked in order and each value is yielded through Yield. The
// clause doesn't resume: it keeps resume in a thunk, so the walk becomes a
// stream of continuations that sum pulls to the end. Each pull resumes the
// walk after its clause has returned, under the handler again (KI-225).
import Flow.Env as Env
import Flow.Array as Array

type Tree = Leaf | Node(Tree, Int, Tree)
type Gen = Empty | Thunk(Int, () -> Gen)

effect Yield {
    yield : (Int) -> ()
}

fn make(n: Int) -> Tree {
    if n == 0 { Leaf } else {
        let t = make(n - 1)
        Node(t, n, t)
    }
}

fn visit(l: Tree, v: Int, r: Tree) with Yield {
    iterate(l)
    perform Yield.yield(v)
    iterate(r)
}

fn iterate(t: Tree) with Yield {
    match t {
        Leaf -> (),
        Node(l, v, r) -> visit(l, v, r),
    }
}

fn walk(t: Tree) -> Gen with Yield {
    iterate(t)
    Empty
}

fn generate(t: Tree) -> Gen {
    walk(t) handle Yield { yield(resume, v) -> Thunk(v, \() -> resume(())) }
}

// One function, not two: the VM keeps a frame for a tail call to another
// function that releases a value first (KI-235).
fn sum(a: Int, g: Gen) -> Int {
    match g {
        Empty -> a,
        Thunk(v, f) -> sum(v + a, f()),
    }
}

fn run(n: Int) -> Int {
    sum(0, generate(make(n)))
}

// The workload size: the program's first argument, or the size the suite
// was written with. `cargo xtask bench` passes a smaller one to the VM.
fn size(default: Int) -> Int with Env {
    match Array.get(Env.args(), 1) {
        Some(s) -> parse_int(s),
        None -> default,
    }
}

fn main() with IO {
    print(run(size(25)))
}
