// parity: vm, llvm
// expect: success
// bug: An unannotated function used to be monomorphic unless its author wrote
//       out `<a>`, so `identity(3)` pinned it to `Int` and `identity("s")` was
//       an E300. Generalization is by arity now: a function with parameters
//       gets a scheme. A regression reads as an argument type mismatch at the
//       second use, or as a backend disagreeing about which dictionary a
//       constrained helper receives.

fn identity(x) { x }

fn apply_twice(f, x) { f(f(x)) }

// Unannotated and constrained: the caller supplies the `Num` dictionary.
fn double(x) { x + x }

fn main() with IO {
    print(identity(3));
    print(identity("s"));
    print(identity(true));
    print(double(3));
    print(double(2.5));
    // Passing a *constrained* helper as a value drops its dictionary
    // (docs/known_issues.md#ki-090), so `apply_twice` is exercised with an
    // unconstrained one until that is fixed.
    print(apply_twice(identity, 9));
}
