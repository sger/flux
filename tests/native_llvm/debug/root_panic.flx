// The root fiber panics (0188 S8): the debugger stops once, where it
// panics, not again when `run_async` fails with it.
import Flow.Async exposing (..)

fn body() -> Int with Async {
    let n = 3
    if n > 2 {
        panic("root gave up")
    } else {
        n
    }
}

fn main() with IO {
    print(run_async(body))
}
