// parity: vm, llvm
// expect: success
// requires: unix
// Proposal 0178: TryReadFile is the first primop that reports failure as a
// value. The two backends classify failures independently — the VM matches on
// Rust's io::ErrorKind, the C runtime on errno — so identical output here is a
// real invariant, not a shared code path.
//
// Windows refuses to open a directory with `ERROR_ACCESS_DENIED`, which both
// backends report as `PermissionDenied`, so the `directory` line is a claim
// about the host OS rather than about Flux.
// parity-expected-stdout-begin
// "existing ok nonempty=true"
// "missing err NotFound"
// "directory err IsADirectory"
// "defaulted"
// parity-expected-stdout-end

import Flow.Fs as Fs
import Flow.IoError as Io

fn probe(label: String, path: String) -> Unit with IO {
    match Fs.read_file(path) {
        Ok(content) -> println(label + " ok nonempty=" + to_string(len(content) > 0)),
        Err(e) -> println(label + " err " + Io.kind_name(Io.error_kind(e))),
    }
}

fn main() -> Unit with IO {
    probe("existing", "Cargo.toml")
    probe("missing", "/nonexistent/definitely/absent.txt")
    probe("directory", "src")
    println(Fs.read_file_or("/nonexistent/fallback.txt", "defaulted"))
}
