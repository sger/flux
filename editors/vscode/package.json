{
  "name": "flux-language",
  "displayName": "Flux Language Support",
  "description": "Syntax highlighting and language server integration for the Flux language.",
  "version": "0.0.5",
  "publisher": "flux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sger/flux.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:flux"
  ],
  "contributes": {
    "languages": [
      {
        "id": "flux",
        "aliases": [
          "Flux",
          "flux"
        ],
        "extensions": [
          ".flx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "flux",
        "scopeName": "source.flux",
        "path": "./syntaxes/flux.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Flux",
      "properties": {
        "flux.serverPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the flux-lsp binary. Leave empty to use the binary bundled with this extension."
        },
        "flux.runCommand": {
          "type": "string",
          "default": "cargo run --",
          "description": "Base command the ▶ Run / ▶ Run Test code lenses launch in a terminal. The file path (and, for tests, --test --test-filter <name>) is appended."
        },
        "flux.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP messages between VS Code and flux-lsp."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}
