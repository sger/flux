// Debug parity (0188 S7): stepping into a perform stops in the handler's
// arm; stepping over one stops at the next line of the same call, after the
// handler resumed it; stepping out of a resumed frame goes on in the frame
// the continuation returns to.
// dbg: break 25
// dbg: continue
// dbg: step
// dbg: bt
// dbg: delete 25
// dbg: break 26
// dbg: continue
// dbg: next
// dbg: bt
// dbg: next
// dbg: continue
// dbg: finish
// dbg: bt
// dbg: continue

effect Flip {
    flip : () -> Bool
}

fn decide() -> Int with Flip {
    let b = perform Flip.flip()
    if b { 1 } else { 2 }
}

fn twice() -> Int with Flip {
    let d = decide()
    d * 10
}

fn main() with IO {
    let result = twice() handle Flip {
        flip(resume) -> resume(true) + resume(false)
    }
    print(to_string(result))
}
