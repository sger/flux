// Tests for Flow.Map.
//
// `Map` is a HAMT: every operation returns a new map and leaves the original
// untouched. That persistence is the property most worth pinning, so the
// mutation tests all re-check the source map afterwards.
//
// `keys` and `values` return Arrays in HAMT iteration order, which is not
// insertion order and is not guaranteed stable. Tests therefore assert on
// membership and size, never on position.

import Flow.Map as Map
import Flow.Array as Array

fn sample() -> Map<String, Int> {
    {"a": 1, "b": 2, "c": 3}
}

// ── lookup ─────────────────────────────────────────────────────

fn test_get_returns_some_for_a_present_key() {
    assert_eq(Map.get(sample(), "b"), Some(2))
}

fn test_get_returns_none_for_an_absent_key() {
    assert_eq(Map.get(sample(), "zz"), None)
}

fn test_get_on_the_empty_map_is_none() {
    let empty: Map<String, Int> = {}
    assert_eq(Map.get(empty, "a"), None)
}

fn test_has_agrees_with_get() {
    assert_true(Map.has(sample(), "a"))
    assert_false(Map.has(sample(), "zz"))
}

// ── size ───────────────────────────────────────────────────────

fn test_size_counts_entries() {
    assert_eq(Map.size(sample()), 3)
}

fn test_the_empty_map_has_size_zero() {
    let empty: Map<String, Int> = {}
    assert_eq(Map.size(empty), 0)
}

// ── insertion is persistent ────────────────────────────────────

fn test_set_adds_a_new_key() {
    let extended = Map.set(sample(), "d", 4)
    assert_eq(Map.get(extended, "d"), Some(4))
    assert_eq(Map.size(extended), 4)
}

/// The defining property of a persistent map: the original is unchanged.
fn test_set_does_not_mutate_the_original() {
    let base = sample()
    let extended = Map.set(base, "d", 4)
    assert_eq(Map.get(base, "d"), None)
    assert_eq(Map.size(base), 3)
    assert_eq(Map.size(extended), 4)
}

fn test_set_replaces_an_existing_key_without_growing() {
    let updated = Map.set(sample(), "a", 99)
    assert_eq(Map.get(updated, "a"), Some(99))
    assert_eq(Map.size(updated), 3)
}

fn test_setting_the_same_key_twice_keeps_the_last_value() {
    let m = Map.set(Map.set({}, "k", 1), "k", 2)
    assert_eq(Map.get(m, "k"), Some(2))
    assert_eq(Map.size(m), 1)
}

// ── deletion is persistent ─────────────────────────────────────

fn test_delete_removes_a_key() {
    let smaller = Map.delete(sample(), "b")
    assert_eq(Map.get(smaller, "b"), None)
    assert_eq(Map.size(smaller), 2)
}

fn test_delete_does_not_mutate_the_original() {
    let base = sample()
    let smaller = Map.delete(base, "b")
    assert_eq(Map.get(base, "b"), Some(2))
    assert_eq(Map.size(base), 3)
    assert_eq(Map.size(smaller), 2)
}

/// Deleting something that was never there is not an error.
fn test_deleting_an_absent_key_is_a_no_op() {
    let same = Map.delete(sample(), "zz")
    assert_eq(Map.size(same), 3)
    assert_eq(Map.get(same, "a"), Some(1))
}

fn test_delete_then_set_round_trips() {
    let m = Map.set(Map.delete(sample(), "a"), "a", 1)
    assert_eq(Map.get(m, "a"), Some(1))
    assert_eq(Map.size(m), 3)
}

// ── merge ──────────────────────────────────────────────────────

fn test_merge_combines_disjoint_maps() {
    let merged = Map.merge({"a": 1}, {"b": 2})
    assert_eq(Map.size(merged), 2)
    assert_eq(Map.get(merged, "a"), Some(1))
    assert_eq(Map.get(merged, "b"), Some(2))
}

/// The documented conflict rule: the right operand wins.
fn test_merge_lets_the_right_operand_win_on_conflicts() {
    let merged = Map.merge({"k": 1}, {"k": 2})
    assert_eq(Map.get(merged, "k"), Some(2))
    assert_eq(Map.size(merged), 1)
}

fn test_merging_with_the_empty_map_changes_nothing() {
    let empty: Map<String, Int> = {}
    assert_eq(Map.size(Map.merge(sample(), empty)), 3)
    assert_eq(Map.size(Map.merge(empty, sample())), 3)
}

fn test_merge_does_not_mutate_either_operand() {
    let left = {"a": 1}
    let right = {"a": 2}
    let merged = Map.merge(left, right)
    assert_eq(Map.get(left, "a"), Some(1))
    assert_eq(Map.get(right, "a"), Some(2))
    assert_eq(Map.get(merged, "a"), Some(2))
}

// ── keys and values ────────────────────────────────────────────

/// Order is HAMT iteration order, so membership and count are asserted
/// rather than position.
fn test_keys_contains_every_key() {
    let ks = Map.keys(sample())
    assert_eq(len(ks), 3)
    assert_true(Array.contains(ks, "a"))
    assert_true(Array.contains(ks, "b"))
    assert_true(Array.contains(ks, "c"))
}

fn test_values_contains_every_value() {
    let vs = Map.values(sample())
    assert_eq(len(vs), 3)
    assert_true(Array.contains(vs, 1))
    assert_true(Array.contains(vs, 2))
    assert_true(Array.contains(vs, 3))
}

fn test_keys_and_values_of_the_empty_map_are_empty() {
    let empty: Map<String, Int> = {}
    assert_eq(len(Map.keys(empty)), 0)
    assert_eq(len(Map.values(empty)), 0)
}

fn test_keys_and_values_have_the_same_length_as_size() {
    let m = Map.set(sample(), "d", 4)
    assert_eq(len(Map.keys(m)), Map.size(m))
    assert_eq(len(Map.values(m)), Map.size(m))
}

// ── building by folding ────────────────────────────────────────

/// The usual way a map is built from a sequence: fold `set` over it.
fn test_a_map_can_be_folded_up_from_a_list() {
    let m = fold([1, 2, 3], {}, \(acc, n) -> Map.set(acc, to_string(n), n * 10))
    assert_eq(Map.size(m), 3)
    assert_eq(Map.get(m, "2"), Some(20))
}

fn test_folding_duplicate_keys_keeps_the_last() {
    let m = fold([1, 1, 1], {}, \(acc, n) -> Map.set(acc, "k", n))
    assert_eq(Map.size(m), 1)
}

// ── integer keys ───────────────────────────────────────────────

fn test_maps_work_with_integer_keys() {
    let m = Map.set(Map.set({}, 1, "one"), 2, "two")
    assert_eq(Map.get(m, 1), Some("one"))
    assert_eq(Map.get(m, 2), Some("two"))
    assert_eq(Map.get(m, 3), None)
    assert_eq(Map.size(m), 2)
}
