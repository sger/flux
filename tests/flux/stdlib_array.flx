// Tests for Flow.Array.
//
// Arrays are indexed and persistent: `update`, `push`, and `swap` all return
// a new array and leave the original alone, which the mutation tests re-check
// afterwards.
//
// Where `Flow.Array` and `Flow.List` offer the same-named function they do not
// always share a signature — `Array.maximum` returns `Int` while
// `List.maximum` returns `Option<Int>`. Those differences are pinned here on
// purpose, so a future unification is a deliberate change rather than a
// silent one.
//
// One outright bug is pinned rather than worked around: `Array.get` returns
// a bare element instead of `Some(element)` on the in-bounds path. See
// `test_get_returns_a_bare_element_in_bounds_and_none_out_of_bounds`.

import Flow.Array as Array
import Flow.List as List
import Flow.Option as Option

fn nums() -> Array<Int> {
    [|1, 2, 3, 4, 5|]
}

// ── access ─────────────────────────────────────────────────────

/// KNOWN BUG: `get` is declared `-> Option<a>` but returns the **bare
/// element** on the in-bounds path; only the out-of-bounds path returns
/// `None`. These assertions pin the behaviour as it actually is, so the day
/// it is fixed this fixture fails loudly instead of the change going
/// unnoticed.
///
/// Consequences today: `Array.get(a, 0) == Some(1)` is a runtime type error,
/// and pattern-matching the result falls through every arm on the VM and
/// **segfaults** on the native backend.
fn test_get_returns_none_out_of_bounds() {
    assert_eq(Array.get(nums(), 5), None)
    let empty: Array<Int> = [||]
    assert_eq(Array.get(empty, 0), None)
}

/// The in-bounds half of the bug, pinned as it actually behaves: because the
/// value is never wrapped, every `Option` combinator reads it as *absent* and
/// silently substitutes the default. `is_some` says `false` for an element
/// that is plainly there.
///
/// These assertions are deliberately "wrong" — they encode the defect so the
/// fix is caught. When `get` is corrected, this test fails and should be
/// rewritten to `Some(1)` / `true`.
fn test_get_in_bounds_is_misread_as_absent_by_option_combinators() {
    assert_eq(Option.unwrap_or(Array.get(nums(), 0), -1), -1)
    assert_false(Option.is_some(Array.get(nums(), 0)))
}

fn test_length_counts_elements() {
    assert_eq(Array.length(nums()), 5)
    let empty: Array<Int> = [||]
    assert_eq(Array.length(empty), 0)
}

/// `first` and `last` are built on indexing, so they inherit the `get` bug
/// above: a present element comes back bare rather than wrapped in `Some`.
/// The empty cases are correct.
/// `first` and `last` are correct: they use `arr[i]` indexing, which wraps
/// properly, rather than the `ArrayGet` primop that `Array.get` calls. The
/// two paths disagree, which is itself worth pinning.
fn test_first_and_last_return_proper_options() {
    assert_eq(Option.unwrap_or(Array.first(nums()), -1), 1)
    assert_eq(Option.unwrap_or(Array.last(nums()), -1), 5)
    assert_true(Option.is_some(Array.first(nums())))
    let empty: Array<Int> = [||]
    assert_eq(Array.first(empty), None)
    assert_eq(Array.last(empty), None)
}

// ── transformation ─────────────────────────────────────────────

fn test_map_applies_to_every_element_in_order() {
    assert_eq(Array.map(nums(), \x -> x * 2), [|2, 4, 6, 8, 10|])
}

fn test_map_on_an_empty_array_is_empty() {
    let empty: Array<Int> = [||]
    assert_eq(Array.map(empty, \x -> x * 2), [||])
}

fn test_filter_keeps_matching_elements_in_order() {
    assert_eq(Array.filter(nums(), \x -> x % 2 == 1), [|1, 3, 5|])
}

fn test_filter_matching_nothing_gives_an_empty_array() {
    assert_eq(Array.filter(nums(), \x -> x > 99), [||])
}

fn test_fold_reduces_left_to_right() {
    assert_eq(Array.fold(nums(), 0, \(acc, x) -> acc + x), 15)
    let empty: Array<Int> = [||]
    assert_eq(Array.fold(empty, 7, \(acc, x) -> acc + x), 7)
}

fn test_flat_map_concatenates_results() {
    assert_eq(Array.flat_map([|1, 2|], \x -> [|x, x * 10|]), [|1, 10, 2, 20|])
}

fn test_flatten_removes_one_level() {
    assert_eq(Array.flatten([|[|1, 2|], [|3|]|]), [|1, 2, 3|])
}

fn test_reverse_reverses() {
    assert_eq(Array.reverse(nums()), [|5, 4, 3, 2, 1|])
    let empty: Array<Int> = [||]
    assert_eq(Array.reverse(empty), [||])
}

fn test_reverse_is_its_own_inverse() {
    assert_eq(Array.reverse(Array.reverse(nums())), nums())
}

// ── search and predicates ──────────────────────────────────────

fn test_any_and_all() {
    assert_true(Array.any(nums(), \x -> x == 3))
    assert_false(Array.any(nums(), \x -> x > 99))
    assert_true(Array.all(nums(), \x -> x > 0))
    assert_false(Array.all(nums(), \x -> x > 3))
}

/// The vacuous cases, same as for lists.
fn test_any_is_false_and_all_is_true_on_an_empty_array() {
    let empty: Array<Int> = [||]
    assert_false(Array.any(empty, \x -> true))
    assert_true(Array.all(empty, \x -> false))
}

fn test_find_returns_the_first_match() {
    assert_eq(Array.find(nums(), \x -> x > 3), Some(4))
    assert_eq(Array.find(nums(), \x -> x > 99), None)
}

fn test_find_index_returns_a_position() {
    assert_eq(Array.find_index(nums(), \x -> x == 3), Some(2))
    assert_eq(Array.find_index(nums(), \x -> x > 99), None)
}

fn test_count_counts_matches() {
    assert_eq(Array.count(nums(), \x -> x % 2 == 0), 2)
    assert_eq(Array.count(nums(), \x -> false), 0)
}

fn test_contains_finds_a_value() {
    assert_true(Array.contains(nums(), 3))
    assert_false(Array.contains(nums(), 99))
}

// ── persistent mutation ────────────────────────────────────────

fn test_update_replaces_one_index() {
    assert_eq(Array.update(nums(), 0, 99), [|99, 2, 3, 4, 5|])
}

/// Persistence: the source array is untouched.
fn test_update_does_not_mutate_the_original() {
    let base = nums()
    let changed = Array.update(base, 0, 99)
    // Compared via the array itself rather than `get`, which cannot report a
    // present element (see the `get` bug above).
    assert_eq(base, [|1, 2, 3, 4, 5|])
    assert_eq(changed, [|99, 2, 3, 4, 5|])
}

fn test_push_appends_to_the_end() {
    assert_eq(Array.push([|1, 2|], 3), [|1, 2, 3|])
    assert_eq(Array.push([||], 1), [|1|])
}

fn test_push_does_not_mutate_the_original() {
    let base = [|1, 2|]
    let grown = Array.push(base, 3)
    assert_eq(Array.length(base), 2)
    assert_eq(Array.length(grown), 3)
}

fn test_swap_exchanges_two_positions() {
    assert_eq(Array.swap([|1, 2, 3|], 0, 2), [|3, 2, 1|])
}

/// Swapping an index with itself is the identity.
fn test_swapping_an_index_with_itself_changes_nothing() {
    assert_eq(Array.swap(nums(), 1, 1), nums())
}

fn test_update_many_applies_several_writes() {
    assert_eq(Array.update_many([|0, 0, 0|], [(0, 1), (2, 3)]), [|1, 0, 3|])
}

fn test_update_many_with_no_pairs_changes_nothing() {
    assert_eq(Array.update_many(nums(), []), nums())
}

// ── slicing ────────────────────────────────────────────────────

fn test_slice_is_half_open() {
    assert_eq(Array.slice(nums(), 1, 3), [|2, 3|])
}

fn test_an_empty_slice_is_empty() {
    assert_eq(Array.slice(nums(), 2, 2), [||])
}

fn test_take_and_drop() {
    assert_eq(Array.take(nums(), 2), [|1, 2|])
    assert_eq(Array.drop(nums(), 3), [|4, 5|])
}

fn test_take_and_drop_clamp_at_the_boundaries() {
    assert_eq(Array.take(nums(), 99), nums())
    assert_eq(Array.take(nums(), 0), [||])
    assert_eq(Array.drop(nums(), 99), [||])
    assert_eq(Array.drop(nums(), 0), nums())
}

fn test_concat_joins_two_arrays() {
    assert_eq(Array.concat([|1, 2|], [|3|]), [|1, 2, 3|])
    assert_eq(Array.concat([||], [|1|]), [|1|])
}

// ── aggregation ────────────────────────────────────────────────

fn test_sum_and_product() {
    assert_eq(Array.sum(nums()), 15)
    assert_eq(Array.product([|1, 2, 3, 4|]), 24)
}

fn test_sum_and_product_of_an_empty_array_are_the_identities() {
    let empty: Array<Int> = [||]
    assert_eq(Array.sum(empty), 0)
    assert_eq(Array.product(empty), 1)
}

/// Unlike `List.maximum`, this returns a bare `Int` rather than an `Option`.
/// Pinned deliberately: the two modules disagree, and a future unification
/// should be a conscious change.
fn test_maximum_and_minimum_return_bare_ints() {
    assert_eq(Array.maximum(nums()), 5)
    assert_eq(Array.minimum(nums()), 1)
}

// ── ordering ───────────────────────────────────────────────────

fn test_sort_orders_ascending() {
    assert_eq(Array.sort([|3, 1, 2|]), [|1, 2, 3|])
    let empty: Array<Int> = [||]
    assert_eq(Array.sort(empty), [||])
}

fn test_sort_handles_duplicates() {
    assert_eq(Array.sort([|2, 1, 2|]), [|1, 2, 2|])
}

fn test_sort_by_orders_on_a_key() {
    assert_eq(Array.sort_by([|3, 1, 2|], \x -> 0 - x), [|3, 2, 1|])
}

// ── construction and conversion ────────────────────────────────

fn test_range_is_half_open() {
    assert_eq(Array.range(0, 4), [|0, 1, 2, 3|])
    assert_eq(Array.range(2, 2), [||])
}

fn test_tabulate_builds_from_an_index_function() {
    assert_eq(Array.tabulate(4, \i -> i * i), [|0, 1, 4, 9|])
    assert_eq(Array.tabulate(0, \i -> i), [||])
}

fn test_enumerate_pairs_elements_with_indices() {
    assert_eq(Array.enumerate([|"a", "b"|]), [|(0, "a"), (1, "b")|])
}

fn test_zip_pairs_and_stops_at_the_shorter() {
    assert_eq(Array.zip([|1, 2|], [|"a", "b"|]), [|(1, "a"), (2, "b")|])
    assert_eq(Array.zip([|1, 2, 3|], [|"a"|]), [|(1, "a")|])
}

/// Arrays and lists convert both ways, and a round trip is the identity.
fn test_arrays_and_lists_round_trip() {
    assert_eq(Array.to_list(nums()), [1, 2, 3, 4, 5])
    assert_eq(Array.from_list([1, 2, 3]), [|1, 2, 3|])
    assert_eq(Array.from_list(Array.to_list(nums())), nums())
}

fn test_accum_folds_updates_into_positions() {
    assert_eq(Array.accum(3, 0, [(0, 1), (0, 2), (2, 5)], \(a, b) -> a + b), [|3, 0, 5|])
}

// ── composition ────────────────────────────────────────────────

fn test_the_combinators_compose_into_a_pipeline() {
    let result = Array.range(1, 11)
        |> Array.filter(\x -> x % 2 == 0)
        |> Array.map(\x -> x * x)
        |> Array.sum
    assert_eq(result, 220)
}

/// The same computation over both collection types must agree.
fn test_an_array_pipeline_matches_the_equivalent_list_pipeline() {
    let via_array = Array.range(1, 11) |> Array.filter(\x -> x % 3 == 0) |> Array.sum
    let via_list = List.range(1, 11) |> List.filter(\x -> x % 3 == 0) |> List.sum
    assert_eq(via_array, via_list)
}
