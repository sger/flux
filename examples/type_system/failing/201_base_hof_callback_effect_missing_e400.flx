// parity-expected-stdout-begin
// parity-expected-stdout-end
// expect: compile_error

// E400: Base HOF callback effect requirement must be available in ambient context.

fn noisy_log(n: Int) -> Unit with IO {
    print("tick")
}

// A helper, not `main`: an entry function gets default handlers for the
// effects of what it calls, which would supply Console.
fn tick_all() with Time {
    each([1, 2, 3], noisy_log) //~ E300 E400
}

fn main() with Time {
    tick_all()
}
