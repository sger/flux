// root: examples/type_system
// expect: compile_error
// expect-error: E300

// E300: a non-list value for List<Int> is caught at compile time, before the
// runtime boundary check (E1004).
import TypeSystem.BoundaryUnknown

fn sum_list(xs: List<Int>) -> Int {
    fold(xs, 0, \(acc: Int, x: Int) -> acc + x)
}

let dynamic = TypeSystem.BoundaryUnknown.dynamic_string()
sum_list(dynamic)
