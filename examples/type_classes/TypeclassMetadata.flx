// Baseline supported behavior: public class and instance metadata belongs in
// the module interface and must survive a consumer reload.
// This module-only fixture is consumed by the interface round-trip test.
// Expected interface: one public class and one public Int instance.

module TypeclassMetadata {
    public class Sizeable<a> {
        fn size(x: a) -> Int
    }

    public instance Sizeable<Int> {
        fn size(x) { x }
    }
}
