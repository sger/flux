// Flow.Http — HTTP/1.1 server foundation (proposal 0174 Phase 3a).
//
// Phase 3a keeps `Bytes` as a transparent `String` alias. The Rust HTTP
// parser/writer remains authoritative; this Flux surface owns VM-safe async
// server orchestration so handlers stay on the VM fiber scheduler thread.

import Flow.Async exposing (..)
import Flow.Tcp as Tcp

module Flow.Http {

    public alias Bytes = String

    public data Method {
        Get,
        Post,
        Put,
        Delete,
        Patch,
        Head,
        Options,
    }

    public data Request {
        Request {
            method:  Method,
            path:    String,
            headers: Map<String, String>,
            body:    Bytes,
        }
    }

    public data Response {
        Response {
            status:  Int,
            headers: Map<String, String>,
            body:    Bytes,
        }
    }

    public data ServerConfig {
        ServerConfig {
            max_connections:    Int,
            max_header_bytes:   Int,
            max_body_bytes:     Int,
            request_timeout_ms: Int,
            worker_count:       Option<Int>,
        }
    }

    public data ServerHandle { ServerHandle(Int) }

    data HttpParseResult {
        HttpNeedMore,
        HttpParsed(Request, Int, Bool),
        HttpParseFailure(Int, String),
    }

    intrinsic fn http_serve_config_prim<a>(listener_id: Int, scope_id: Int, config: a) -> Int = primop HttpServeConfig
    intrinsic fn http_parse_request_prim(raw: String, server_id: Int) -> HttpParseResult = primop HttpParseRequest
    intrinsic fn http_write_response_prim(resp: Response, keep_alive: Bool) -> String = primop HttpWriteResponse
    intrinsic fn http_register_connection_prim(server_id: Int, conn_id: Int) -> Unit = primop HttpRegisterConnection
    intrinsic fn http_unregister_connection_prim(server_id: Int, conn_id: Int) -> Unit = primop HttpUnregisterConnection
    intrinsic fn http_active_connection_count_prim(server_id: Int) -> Int = primop HttpActiveConnectionCount
    intrinsic fn http_is_shutting_down_prim(server_id: Int) -> Bool = primop HttpIsShuttingDown
    intrinsic fn http_shutdown_prim(h: Int) -> Unit = primop HttpShutdown
    intrinsic fn http_shutdown_now_prim(h: Int) -> Unit = primop HttpShutdownNow

    public fn default_config() -> ServerConfig {
        ServerConfig {
            max_connections:    10000,
            max_header_bytes:   65536,
            max_body_bytes:     8388608,
            request_timeout_ms: 30000,
            worker_count:       None,
        }
    }

    public fn server_config(
        max_connections:    Int,
        max_header_bytes:   Int,
        max_body_bytes:     Int,
        request_timeout_ms: Int
    ) -> ServerConfig {
        ServerConfig {
            max_connections:    max_connections,
            max_header_bytes:   max_header_bytes,
            max_body_bytes:     max_body_bytes,
            request_timeout_ms: request_timeout_ms,
            worker_count:       None,
        }
    }

    public fn response(status: Int, body: String) -> Response {
        Response {
            status:  status,
            headers: {},
            body:    body,
        }
    }

    public fn ok(body: String) -> Response {
        response(200, body)
    }

    public fn serve_config(
        addr:    String,
        port:    Int,
        config:  ServerConfig,
        handler: (Request) -> Response with Async | e
    ) -> ServerHandle with Async, AsyncFail {
        serve_config_impl(addr, port, handler, config)
    }

    fn serve_config_impl(
        addr:    String,
        port:    Int,
        handler,
        config:  ServerConfig
    ) -> ServerHandle with Async, AsyncFail {
        let listener = Tcp.listen(addr, port)
        let server_scope = new_scope()
        let server_id = http_serve_config_prim(Tcp.listener_id(listener), scope_id(server_scope), config)
        fn serve_accept_body() with Async, AsyncFail {
            accept_loop(server_id, listener, server_scope, handler)
        }
        let ignored_serve_fork = fork(server_scope, serve_accept_body)
        ServerHandle(server_id)
    }

    public fn serve(
        addr:    String,
        port:    Int,
        handler: (Request) -> Response with Async | e
    ) -> ServerHandle with Async, AsyncFail {
        let cfg = default_config()
        serve_config(addr, port, cfg, handler)
    }

    public fn shutdown(h: ServerHandle) -> Unit with Async, AsyncFail {
        match h {
            ServerHandle(id) -> shutdown_id(id)
        }
    }

    public fn shutdown_now(h: ServerHandle) -> Unit with Async, AsyncFail {
        match h {
            ServerHandle(id) -> http_shutdown_now_prim(id)
        }
    }

    fn accept_loop(
        server_id:    Int,
        listener,
        server_scope,
        handler:      (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        if http_is_shutting_down_prim(server_id) { noop() }
        else {
            fn accept_once() with Async, AsyncFail {
                Tcp.accept(listener)
            }
            fn accept_ok(conn) with Async, AsyncFail {
                accepted_connection(server_id, listener, server_scope, conn, handler)
            }
            let accept_result = try_(accept_once)
            result_or_else_async(
                accept_result,
                noop(),
                accept_ok
            )
        }
    }

    fn connection_worker(
        server_id: Int,
        conn,
        buffer:    String,
        handler:   (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        fn connection_body() with Async, AsyncFail {
            connection_loop(server_id, conn, buffer, handler)
        }
        let ignored_connection_result = connection_body()
        close_connection(server_id, conn)
    }

    fn connection_loop(
        server_id: Int,
        conn,
        buffer:    String,
        handler:   (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        match http_parse_request_prim(buffer, server_id) {
            HttpNeedMore -> need_more(server_id, conn, buffer, handler),
            HttpParseFailure(status, message) -> write_response_and_close(server_id, conn, response(status, message)),
            HttpParsed(req, consumed, keep_alive) -> handle_parsed(server_id, conn, buffer, req, consumed, keep_alive, handler)
        }
    }

    fn need_more(
        server_id: Int,
        conn,
        buffer:    String,
        handler:   (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        if http_is_shutting_down_prim(server_id) { close_connection(server_id, conn) }
        else {
            fn read_once() with Async, AsyncFail {
                Tcp.read(conn, 4096)
            }
            let read_result = timeout_result(50, read_once)
            if result_is_timed_out(read_result) { connection_loop(server_id, conn, buffer, handler) }
            else {
                let chunk = result_or(read_result, "")
                read_chunk(server_id, conn, buffer, chunk, handler)
            }
        }
    }

    fn shutdown_id(id: Int) -> Unit with Async, AsyncFail {
        let ignored_shutdown = http_shutdown_prim(id)
        wait_for_shutdown(id)
    }

    fn accepted_connection(
        server_id:    Int,
        listener,
        server_scope,
        conn,
        handler:      (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        let ignored_register_connection = http_register_connection_prim(server_id, Tcp.connection_id(conn))
        fn connection_fork_body() with Async, AsyncFail {
            connection_worker(server_id, conn, "", handler)
        }
        let ignored_connection_fork = fork(server_scope, connection_fork_body)
        accept_loop(server_id, listener, server_scope, handler)
    }

    fn read_chunk(
        server_id: Int,
        conn,
        buffer:    String,
        chunk:     String,
        handler:   (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        if chunk == "" { close_connection(server_id, conn) }
        else { connection_loop(server_id, conn, buffer + chunk, handler) }
    }

    fn write_response_and_close(server_id: Int, conn, resp: Response) -> Unit with Async, AsyncFail {
        let ignored_write_close = Tcp.write_all(conn, http_write_response_prim(resp, false))
        close_connection(server_id, conn)
    }

    fn handle_parsed(
        server_id:  Int,
        conn,
        buffer:     String,
        req:        Request,
        consumed:   Int,
        keep_alive: Bool,
        handler:    (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        let rest = substring(buffer, consumed, len(buffer))
        let next_keep_alive = keep_alive && !http_is_shutting_down_prim(server_id)
        let handler_result = run_handler(req, handler)
        if result_is_timed_out(handler_result) { write_response_and_close(server_id, conn, response(504, "Gateway Timeout")) }
        else {
            let resp = result_or(handler_result, response(500, "Internal Server Error"))
            write_response_then_continue(server_id, conn, rest, resp, next_keep_alive, handler)
        }
    }

    fn write_response_then_continue(
        server_id:       Int,
        conn,
        rest:            String,
        resp:            Response,
        next_keep_alive: Bool,
        handler:         (Request) -> Response with Async | e
    ) -> Unit with Async, AsyncFail {
        let ignored_write_continue = Tcp.write_all(conn, http_write_response_prim(resp, next_keep_alive))
        if next_keep_alive { connection_loop(server_id, conn, rest, handler) }
        else { close_connection(server_id, conn) }
    }

    fn run_handler(
        req: Request,
        handler: (Request) -> Response with Async | e
    ) with Async, AsyncFail {
        ok_result(handler(req))
    }

    fn close_connection(server_id: Int, conn) {
        let ignored_unregister_connection = http_unregister_connection_prim(server_id, Tcp.connection_id(conn))
        Tcp.close(conn)
    }

    fn wait_for_shutdown(server_id: Int) -> Unit with Async, AsyncFail {
        if http_active_connection_count_prim(server_id) <= 0 { noop() }
        else {
            let ignored_shutdown_sleep = sleep(10)
            wait_for_shutdown(server_id)
        }
    }

    fn noop() -> Unit {
        http_shutdown_now_prim(-1)
    }
}
