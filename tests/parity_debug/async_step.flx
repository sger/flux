// Debug parity (0188 S8): `next` over a sleep lets the other fiber run and
// stops at the next line of the same fiber; once that fiber has finished,
// the step stops where the next one goes on.
// dbg: break 17
// dbg: continue
// dbg: next
// dbg: threads
// dbg: next
// dbg: next
// dbg: next
// dbg: continue

import Flow.Async exposing (..)

fn left() -> Int with Async {
    let a = 1
    sleep(10)
    let b = a + 1
    b * 2
}

fn right() -> Int with Async {
    let c = 10
    c * 3
}

fn body() -> Int with Async {
    let pair = both(left, right)
    pair.0 + pair.1
}

fn main() with IO {
    print(run_async(body))
}
