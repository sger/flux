# Rust
/target/
Cargo.lock

# cargo xtask verify, sweep and fuzz outputs, one folder per run tag;
# `cargo xtask prune` deletes old runs.
/.verify/
# The compiler's old cache folder; package_cli_tests fails if it exists.
/.flux-cache/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store

# Linux
*.o
*.so
*.hi

# Windows
*.exe
*.dll
Thumbs.db

# Editor backups
*.bak
*.orig

# Test files
/test_imports/
*.tmp

# Module interface cache
*.flxi

# C runtime build artifacts
runtime/c/*.a
runtime/c/*.dylib
runtime/c/*.o
runtime/c/*.obj
runtime/c/*.lib
runtime/c/smoke_test
runtime/c/.flux_rt.lock
runtime/c/*.flags

# Debug symbols — they embed the build machine's absolute paths
*.pdb
*.ilk
*.dSYM/

# Benchmark artifacts
/baseline_criterion/

# OCaml compiler artifacts
*.cmi
*.cmo
*.cmx
*.cmxa
*.cmxs

# insta writes these beside the accepted snapshot on a mismatch; they are
# review artifacts, never committed.
*.snap.new

# Python bytecode caches (e.g. from lldb loading tools/lldb/flux_lldb.py)
__pycache__/
*.pyc
