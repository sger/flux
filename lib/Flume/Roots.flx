import Flume.Manifest as Manifest
import Flume.Manifest exposing (Manifest, Package, Dep, FromPath, FromRegistry, FromGit, GitSource)
import Flume.Git as Git
import Flume.Git exposing (Checkout)
import Flow.Fs as Fs
import Flow.Path as Path
import Flow.List as List
import Flow.Array as Array
import Flow.String as String
import Flow.Env as Env
import Flow.Result as Result
import Flow.Option as Option
import Flume.Home as Home
import Flume.Plan as Plan
import Flume.Plan exposing (Outcome)
import Flume.Lock as Lock
import Flume.Lock exposing (Lock, Entry, LockedGit)
import Flume.Index as Index
import Flume.Index exposing (Published)
import Flume.Version as Version
import Flume.Fail as Fail

/// Resolve a project's module search roots from its `flux.toml`.
///
/// This is the Flux half of the Rust/Flux boundary:
/// Flux decides *what* to build, and hands the compiler a flat list of
/// `namespace<TAB>path` records. The Rust side turns each record into a scoped
/// module root and does no manifest parsing of its own.
///
/// Output format, one record per line on stdout:
///
/// ```text
/// ok<TAB><namespace><TAB><module root directory>
/// ```
///
/// A failure is reported as a single line:
///
/// ```text
/// err<TAB><message>
/// ```
///
/// Match arms in Flux take an expression, not a block, so the walk below is
/// split into small helpers rather than written as nested `match` + `let`.
module Flume.Roots {

    /// The lockfile pins, plus what the caller allows the resolution to do.
    ///
    /// Bundled into one record because they travel together through every
    /// step of the walk: each git dependency needs its pin, and needs to know
    /// whether it may reach the network to resolve one it lacks.
    public data Pins {
        Pins {
            locked: List<(String, String)>,
            offline: Bool,
            frozen: Bool,
        }
    }

    fn pins_locked(p: Pins) -> List<(String, String)> {
        match p { Pins { locked, offline: _, frozen: _ } -> locked }
    }

    fn pins_offline(p: Pins) -> Bool {
        match p { Pins { locked: _, offline, frozen: _ } -> offline }
    }

    /// Whether the lockfile must already answer the manifest.
    fn pins_frozen(p: Pins) -> Bool {
        match p { Pins { locked: _, offline: _, frozen } -> frozen }
    }

    /// One resolved package: the namespace it owns and the directory its
    /// modules live under.
    public data Root {
        Root { package: String, namespace: String, dir: String }
    }

    public fn root_package(r: Root) -> String {
        match r { Root { package, namespace: _, dir: _ } -> package }
    }

    public fn root_namespace(r: Root) -> String {
        match r { Root { package: _, namespace, dir: _ } -> namespace }
    }

    public fn root_dir(r: Root) -> String {
        match r { Root { package: _, namespace: _, dir } -> dir }
    }

    /// The directory a package's modules are rooted at.
    ///
    /// A package's `src` directory is the module root when it exists, so
    /// `src/Json/Parse.flx` answers `Json.Parse`. Packages laying modules out
    /// at the top level fall back to the package directory itself.
    fn source_dir(package_dir: String) -> String with IO {
        let candidate = Path.join(package_dir, "src")
        if Fs.is_dir(candidate) { candidate } else { package_dir }
    }

    /// The root contributed by the package itself, before its dependencies.
    fn own_root(manifest: Manifest, dir: String) -> Root with IO {
        let package = Manifest.manifest_package(manifest)
        Root {
            package: Manifest.package_name(package),
            namespace: Manifest.package_namespace(package),
            dir: source_dir(dir),
        }
    }

    /// Resolve `dir`'s manifest and every path dependency reachable from it.
    ///
    /// `seen` carries the package directories already visited so a dependency
    /// cycle terminates instead of recursing forever.
    fn resolve_from(
        dir: String,
        seen: List<String>,
        locked: Pins,
    ) -> Result<List<Root>, String> with IO {
        if List.contains(seen, dir) {
            Ok([])
        } else {
            read_manifest(dir, seen, locked)
        }
    }

    fn read_manifest(
        dir: String,
        seen: List<String>,
        locked: Pins,
    ) -> Result<List<Root>, String> with IO {
        let manifest_path = Path.join(dir, "flux.toml")
        match Fs.read_file(manifest_path) {
            Err(_) -> Err("cannot read " + manifest_path),
            Ok(text) -> parse_manifest(text, manifest_path, dir, seen, locked),
        }
    }

    fn parse_manifest(
        text: String,
        manifest_path: String,
        dir: String,
        seen: List<String>,
        locked: Pins,
    ) -> Result<List<Root>, String> with IO {
        match Manifest.parse(text) {
            Err(_) -> Err("cannot parse " + manifest_path),
            Ok(manifest) -> walk_manifest(manifest, dir, seen, locked),
        }
    }

    fn walk_manifest(
        manifest: Manifest,
        dir: String,
        seen: List<String>,
        locked: Pins,
    ) -> Result<List<Root>, String> with IO {
        let own = own_root(manifest, dir)
        resolve_deps(Manifest.manifest_deps(manifest), dir, [dir | seen], [own], locked)
    }

    /// Walk a dependency list, accumulating roots.
    ///
    /// Only path dependencies are followed here: they are resolved by graph
    /// walk, because there is nothing to choose between. Registry
    /// dependencies are collected separately and settled by the solver once
    /// the whole graph is known — resolving them one at a time would defeat
    /// the point of a solver, which is to consider every requirement together.
    ///
    /// Dev dependencies are excluded from the build graph: they belong to a
    /// package's own tests, not to anything that depends on it.
    fn resolve_deps(
        deps: List<Dep>,
        base: String,
        seen: List<String>,
        acc: List<Root>,
        locked: Pins,
    ) -> Result<List<Root>, String> with IO {
        match deps {
            [] -> Ok(acc),
            [dep | rest] -> resolve_dep(dep, rest, base, seen, acc, locked),
        }
    }

    fn resolve_dep(
        dep: Dep,
        rest: List<Dep>,
        base: String,
        seen: List<String>,
        acc: List<Root>,
        locked: Pins,
    ) -> Result<List<Root>, String> with IO {
        if Manifest.dep_is_dev(dep) {
            resolve_deps(rest, base, seen, acc, locked)
        } else {
            match Manifest.dep_source(dep) {
                FromRegistry(_) -> resolve_deps(rest, base, seen, acc, locked),
                FromPath(rel) ->
                    descend(Path.normalize(Path.join(base, rel)), rest, base, seen, acc, locked),
                FromGit(source) ->
                    descend_git(source, Manifest.dep_name(dep), rest, base, seen, acc, locked),
            }
        }
    }

    fn descend(
        dep_dir: String,
        rest: List<Dep>,
        base: String,
        seen: List<String>,
        acc: List<Root>,
        locked: Pins,
    ) -> Result<List<Root>, String> with IO {
        match resolve_from(dep_dir, seen, locked) {
            Err(message) -> Err(message),
            Ok(found) ->
                resolve_deps(rest, base, [dep_dir | seen], List.concat([acc, found]), locked),
        }
    }

//| git dependencies

    /// Fetch a git dependency and walk it like any other package.
    ///
    /// A fetched checkout is an ordinary package directory, so it descends
    /// through the same walk as a path dependency: its own `flux.toml` is
    /// read, and its own dependencies are resolved beneath it. Nothing about
    /// having arrived over the network changes what it contributes.
    ///
    /// Fetching happens during the walk rather than in a separate pass because
    /// a git dependency's *own* dependencies are unknowable until its manifest
    /// is on disk — unlike a registry, a repository publishes no index to read
    /// them from ahead of time.
    fn descend_git(
        source: GitSource,
        name: String,
        rest: List<Dep>,
        base: String,
        seen: List<String>,
        acc: List<Root>,
        locked: Pins,
    ) -> Result<List<Root>, String> with IO {
        match fetch_for(source, name, locked) {
            Err(message) -> Err(message),
            Ok(checkout) -> after_fetch(checkout, name, rest, base, seen, acc, locked),
        }
    }

    /// Fetch a git dependency, honouring `--offline`.
    fn fetch_for(
        source: GitSource,
        name: String,
        pins: Pins,
    ) -> Result<Checkout, String> with IO {
        let pin = lookup(pins_locked(pins), name)
        if pins_offline(pins) {
            Git.fetch_offline(source, pin)
        } else {
            Git.fetch_locked(source, pin)
        }
    }

    /// The commit `flux.lock` recorded for this dependency, if any.
    fn lookup(locked: List<(String, String)>, name: String) -> Option<String> {
        match locked {
            [] -> None,
            [pair | rest] -> match pair {
                (found, commit) -> if found == name {
                    Some(commit)
                } else {
                    lookup(rest, name)
                },
            },
        }
    }

    /// Report a download, then walk the fetched package.
    ///
    /// The report is a record rather than a printed line because the resolver
    /// speaks to the compiler over stdout: the Rust side renders it. A
    /// checkout that was already on disk reports nothing, so a warm build
    /// stays silent.
    fn after_fetch(
        checkout: Checkout,
        name: String,
        rest: List<Dep>,
        base: String,
        seen: List<String>,
        acc: List<Root>,
        locked: Pins,
    ) -> Result<List<Root>, String> with IO {
        let noted = note_fetch(checkout, acc)
        let recorded = note_resolved(name, checkout, noted)
        descend(Git.checkout_dir(checkout), rest, base, seen, recorded, locked)
    }

    /// Record what this dependency resolved to, for the lockfile.
    ///
    /// Carried on the accumulator as a marker root — an empty namespace, which
    /// no real package has — because the walk already threads one list through
    /// every step, and a second one would have to be returned back up through
    /// all of them. `partition_resolved` separates the two at the end.
    ///
    /// Recorded for every git dependency, fetched or cached, because the
    /// lockfile describes the whole resolution rather than the subset that
    /// happened to need downloading.
    fn note_resolved(name: String, checkout: Checkout, acc: List<Root>) -> List<Root> {
        List.concat([acc, [resolved_marker(name, checkout)]])
    }

    fn resolved_marker(name: String, checkout: Checkout) -> Root {
        Root {
            package: name,
            namespace: "",
            dir: Git.checkout_url(checkout) + "#" + Git.checkout_commit(checkout),
        }
    }

    fn is_resolved_marker(r: Root) -> Bool {
        root_namespace(r) == ""
    }

    /// Report a completed download as it happens.
    ///
    /// Printed immediately rather than accumulated with the roots, so it lands
    /// next to the `fetching` line it answers. Batching them to the end put
    /// every "Updating" before every "Fetched", which reads as though nothing
    /// finished until everything had.
    fn note_fetch(checkout: Checkout, acc: List<Root>) -> List<Root> with IO {
        if Git.checkout_fetched(checkout) {
            announce_fetched(checkout, acc)
        } else {
            acc
        }
    }

    fn announce_fetched(checkout: Checkout, acc: List<Root>) -> List<Root> with IO {
        print(
            "fetched\t" + Git.checkout_url(checkout)
                + "\t" + Git.checkout_commit(checkout),
        )
        acc
    }

//| registry dependencies

    /// The registry requirements declared by the project's own manifest.
    ///
    /// Only the root manifest is read. A dependency's own requirements come
    /// from the index; reading them from an unpacked manifest would make
    /// resolution depend on which versions happened to be unpacked already.
    fn registry_requirements(manifest: Manifest) -> List<(String, String)> {
        Manifest.manifest_deps(manifest)
            |> List.filter(is_registry_dep)
            |> List.map(requirement_of)
    }

    fn is_registry_dep(dep: Dep) -> Bool {
        if Manifest.dep_is_dev(dep) {
            false
        } else {
            match Manifest.dep_source(dep) {
                FromPath(_) -> false,
                FromGit(_) -> false,
                FromRegistry(_) -> true,
            }
        }
    }

    fn requirement_of(dep: Dep) -> (String, String) {
        match Manifest.dep_source(dep) {
            FromRegistry(range) -> (Manifest.dep_name(dep), range),
            // Unreachable: the list is filtered to registry deps first.
            FromPath(_) -> (Manifest.dep_name(dep), ""),
            FromGit(_) -> (Manifest.dep_name(dep), ""),
        }
    }

    /// Resolve the project's registry dependencies into module roots.
    ///
    /// A project with no registry dependencies never reads the index and never
    /// runs the solver, so the common case costs nothing.
    fn registry_roots(
        manifest: Manifest,
        dir: String,
    ) -> List<Root> with IO, Fail {
        match registry_requirements(manifest) {
            [] -> [],
            requirements -> resolve_registry(requirements, dir),
        }
    }

    /// Read the index, read the lock, resolve, write if changed.
    ///
    /// Each step aborts on failure, so this reads as the sequence it is.
    fn resolve_registry(
        requirements: List<(String, String)>,
        dir: String,
    ) -> List<Root> with IO, Fail {
        let names = List.map(requirements, first_of)
        let available = Fail.ok_or_abort(Home.read_index(names), [])
        let previous = Fail.ok_or_abort(Home.read_lock(dir), None)
        let outcome = Fail.ok_or_abort(Plan.plan(requirements, available, previous), unchanged())
        persist(outcome, dir)
    }

    fn first_of(pair: (String, String)) -> String {
        match pair { (name, _) -> name }
    }

    /// Unreachable placeholder for the aborting branch above.
    fn unchanged() -> Outcome {
        Unchanged { lock: Lock.lock(Lock.default_format(), []) }
    }

    /// The lockfile is written as part of building, so a build is always
    /// described by a lockfile that matches it.
    fn persist(outcome: Outcome, dir: String) -> List<Root> with IO, Fail {
        let resolved = Plan.outcome_lock(outcome)
        if Plan.outcome_changed(outcome) {
            let _written = Fail.ok_or_abort(Home.write_lock(dir, resolved), "")
            locked_roots(resolved)
        } else {
            locked_roots(resolved)
        }
    }

    /// One root per locked package, rooted at its unpacked sources.
    ///
    /// A resolved-but-unpacked package is reported by name: the resolution is
    /// sound, the sources are simply not on disk yet.
    fn locked_roots(resolved: Lock) -> List<Root> with IO, Fail {
        collect_locked(Lock.lock_packages(resolved))
    }

    fn collect_locked(entries: List<Entry>) -> List<Root> with IO, Fail {
        match entries {
            [] -> [],
            [head | rest] -> [locked_root(head) | collect_locked(rest)],
        }
    }

    fn locked_root(entry: Entry) -> Root with IO, Fail {
        let name = Lock.entry_name(entry)
        let version = Version.render(Lock.entry_version(entry))
        let unpacked = Home.package_dir(name, version)
        if Fs.is_dir(unpacked) {
            package_root(name, unpacked)
        } else {
            Fail.abort(
                "`" + name + "` " + version
                    + " is resolved but its sources are not in " + unpacked,
                package_root(name, unpacked),
            )
        }
    }

    /// The root a registry package contributes.
    ///
    /// Its namespace is derived from its name the same way a path package's
    /// is, so a package owns the same namespace however it was obtained.
    fn package_root(name: String, unpacked: String) -> Root with IO {
        Root {
            package: name,
            namespace: Manifest.derive_namespace(name),
            dir: source_dir(unpacked),
        }
    }

    /// Resolve the roots for the project rooted at `dir`.
    ///
    /// Path dependencies are walked first, then registry dependencies are
    /// resolved and appended. `Fail` is discharged here, so the public result
    /// is an ordinary `Result`.
    public fn resolve(dir: String) -> Result<List<Root>, String> with IO {
        resolve_with(dir, false, false)
    }

    /// Resolve, refusing to reach the network or to change the lockfile.
    ///
    /// `offline` forbids fetching anything not already cached; `frozen` makes
    /// any change to `flux.lock` an error. They are separate because they
    /// answer different questions — "may this build download?" and "may this
    /// build decide something new?" — and CI usually wants both.
    public fn resolve_with(
        dir: String,
        offline: Bool,
        frozen: Bool,
    ) -> Result<List<Root>, String> with IO {
        gather(dir, offline, frozen) handle Fail { fail(resume, message) -> Err(message) }
    }

    fn gather(dir: String, offline: Bool, frozen: Bool) -> Result<List<Root>, String> with IO, Fail {
        let pins = Pins {
            locked: git_pins(dir),
            offline: offline,
            frozen: frozen,
        }
        let walked = Fail.ok_or_abort(resolve_from(dir, [], pins), [])
        let manifest = read_project_manifest(dir)
        let paths = List.filter(walked, is_package_root)
        let _lock = write_git_lock(dir, List.filter(walked, is_resolved_marker), pins)
        Ok(List.concat([paths, registry_roots(manifest, dir)]))
    }

    fn is_package_root(r: Root) -> Bool {
        !is_resolved_marker(r)
    }

    /// Write `flux.lock` when the git resolution differs from what it records.
    ///
    /// Rewriting unconditionally would touch the file on every build, which
    /// shows up as a dirty working tree and a spurious diff in every commit.
    /// The comparison is against the pins read at the start, so a build that
    /// resolved to exactly what was locked writes nothing.
    ///
    /// A failure to write is reported but not fatal: the build itself is
    /// sound — every dependency is on disk at a known commit — and a
    /// read-only checkout should still build.
    fn write_git_lock(
        dir: String,
        markers: List<Root>,
        pins: Pins,
    ) -> Bool with IO, Fail {
        if same_resolution(markers, pins_locked(pins)) {
            false
        } else if pins_frozen(pins) {
            Fail.abort(lock_changed_message(markers, pins_locked(pins)), false)
        } else {
            persist_git_lock(dir, markers)
        }
    }

    /// What `--locked` refuses, named precisely.
    ///
    /// "The lockfile is out of date" alone does not say what to fix, so the
    /// first dependency that disagrees is reported: either it is absent from
    /// the lock, or it resolved to a different commit than the one recorded.
    fn lock_changed_message(markers: List<Root>, locked: List<(String, String)>) -> String {
        match List.filter(markers, \m -> !marker_matches(m, locked)) {
            [changed | _] -> lock_change_detail(changed, locked),
            // Every dependency the manifest declares matches, so the lockfile
            // holds entries for dependencies it no longer declares — the shape
            // a removed dependency leaves behind.
            [] -> stale_entries_message(markers, locked),
        }
    }

    fn stale_entries_message(markers: List<Root>, locked: List<(String, String)>) -> String {
        match List.filter(locked, \pair -> !is_declared(pair, markers)) {
            [] -> "`flux.lock` does not match `flux.toml`, and `--locked` forbids updating it",
            [stale | _] -> "`--locked` was given, but `" + pair_name(stale)
                + "` is in `flux.lock` and is no longer a dependency",
        }
    }

    fn is_declared(pair: (String, String), markers: List<Root>) -> Bool {
        List.any(markers, \m -> root_package(m) == pair_name(pair))
    }

    fn pair_name(pair: (String, String)) -> String {
        match pair { (name, _) -> name }
    }

    fn lock_change_detail(marker: Root, locked: List<(String, String)>) -> String {
        let name = root_package(marker)
        match lookup(locked, name) {
            None -> "`--locked` was given, but `" + name
                + "` is not in `flux.lock`; run without `--locked` to record it",
            Some(commit) -> "`--locked` was given, but `" + name
                + "` resolves to " + marker_commit(marker)
                + " rather than the locked " + commit,
        }
    }

    fn persist_git_lock(dir: String, markers: List<Root>) -> Bool with IO {
        match Home.write_lock(dir, Lock.lock(Lock.default_format(), git_entries(markers))) {
            Err(_) -> false,
            Ok(_) -> true,
        }
    }

    /// Whether every marker matches the commit already locked for it.
    fn same_resolution(markers: List<Root>, locked: List<(String, String)>) -> Bool {
        List.length(markers) == List.length(locked)
            && List.all(markers, \m -> marker_matches(m, locked))
    }

    fn marker_matches(marker: Root, locked: List<(String, String)>) -> Bool {
        match lookup(locked, root_package(marker)) {
            None -> false,
            Some(commit) -> commit == marker_commit(marker),
        }
    }

    /// One `[[package]]` entry per resolved git dependency.
    fn git_entries(markers: List<Root>) -> List<Entry> {
        List.map(markers, git_entry)
    }

    fn git_entry(marker: Root) -> Entry {
        Lock.entry(
            root_package(marker),
            Version.version(0, 0, 0),
            LockedGit { url: marker_url(marker), commit: marker_commit(marker) },
            None,
            [],
        )
    }

    /// A marker's `dir` holds `<url>#<commit>`; these split it back apart.
    fn marker_url(marker: Root) -> String {
        match split_marker(root_dir(marker)) { (url, _) -> url }
    }

    fn marker_commit(marker: Root) -> String {
        match split_marker(root_dir(marker)) { (_, commit) -> commit }
    }

    fn split_marker(text: String) -> (String, String) {
        split_marker_from(text, len(text) - 1)
    }

    /// Scans from the right: a URL may contain `#`, but the commit cannot, so
    /// the last one is the separator.
    fn split_marker_from(text: String, i: Int) -> (String, String) {
        if i < 0 {
            (text, "")
        } else if String.string_slice(text, i, i + 1) == "#" {
            (String.string_slice(text, 0, i), String.string_slice(text, i + 1, len(text)))
        } else {
            split_marker_from(text, i - 1)
        }
    }

    /// The commits `flux.lock` pins each git dependency to.
    ///
    /// Read once, before the walk, so every git dependency in the graph is
    /// resolved against the same lockfile. A missing or unreadable lockfile
    /// yields no pins rather than failing: the first build of a project has
    /// none, and that is the ordinary case rather than an error.
    fn git_pins(dir: String) -> List<(String, String)> with IO {
        match Home.read_lock(dir) {
            Err(_) -> [],
            Ok(None) -> [],
            Ok(Some(found)) -> git_pins_of(Lock.lock_packages(found)),
        }
    }

    fn git_pins_of(entries: List<Entry>) -> List<(String, String)> {
        match entries {
            [] -> [],
            [head | rest] -> match Lock.origin_commit(Lock.entry_origin(head)) {
                None -> git_pins_of(rest),
                Some(commit) -> [(Lock.entry_name(head), commit) | git_pins_of(rest)],
            },
        }
    }


//| update

    /// What `flux update` did to one dependency.
    ///
    /// `before` is the commit `flux.lock` recorded, if it held one at all;
    /// `after` is what the fresh resolution chose. A dependency whose two
    /// agree was already current, and one with no `before` is newly locked.
    public data Change {
        Change { package: String, before: Option<String>, after: String }
    }

    public fn change_package(c: Change) -> String {
        match c { Change { package, before: _, after: _ } -> package }
    }

    public fn change_before(c: Change) -> Option<String> {
        match c { Change { package: _, before, after: _ } -> before }
    }

    public fn change_after(c: Change) -> String {
        match c { Change { package: _, before: _, after } -> after }
    }

    /// Re-resolve `dir`, releasing the lockfile's pins.
    ///
    /// `only` names the packages to update; an empty list updates everything.
    /// Releasing a pin is the whole mechanism: `fetch_locked` re-resolves a
    /// tag or branch exactly when no commit is supplied for it, so dropping a
    /// dependency's entry from the pins is what makes it move. Every pin left
    /// in place holds its sibling where it is, which is what makes
    /// `flux update -p one` conservative without a second code path.
    ///
    /// A `rev` pin does not move: it names a commit in the manifest, and no
    /// resolution can choose otherwise. That is not reported as a failure —
    /// the dependency is simply already at what it asks for.
    public fn update(dir: String, only: List<String>) -> Result<List<Change>, String> with IO {
        updating(dir, only) handle Fail { fail(resume, message) -> Err(message) }
    }

    fn updating(dir: String, only: List<String>) -> Result<List<Change>, String> with IO, Fail {
        let before = git_pins(dir)
        let _checked = check_named(only, before, dir)
        let pins = Pins {
            locked: retained(before, only),
            offline: false,
            frozen: false,
        }
        let walked = Fail.ok_or_abort(resolve_from(dir, [], pins), [])
        let markers = List.filter(walked, is_resolved_marker)
        let _lock = rewrite_lock(dir, markers, before)
        Ok(changes(markers, before))
    }

    /// Reject `-p <name>` for something the project does not depend on.
    ///
    /// Checked against the lockfile rather than the manifest because an
    /// unlocked dependency has nothing to release, so `-p` on one would be a
    /// no-op that silently reported success.
    fn check_named(only: List<String>, before: List<(String, String)>, dir: String) -> Bool with Fail {
        match List.filter(only, \name -> !List.any(before, \pair -> pair_name(pair) == name)) {
            [] -> true,
            [missing | _] -> Fail.abort(
                "`" + missing + "` is not a locked dependency of "
                    + Path.join(dir, "flux.lock"),
                false,
            ),
        }
    }

    /// The pins that survive: everything not being updated.
    fn retained(
        before: List<(String, String)>,
        only: List<String>,
    ) -> List<(String, String)> {
        match only {
            [] -> [],
            _ -> List.filter(before, \pair -> !List.contains(only, pair_name(pair))),
        }
    }

    /// Write the lockfile unless the resolution came back identical.
    ///
    /// The same rule `write_git_lock` follows, minus the `--locked` check:
    /// `update` is the command whose whole purpose is to change the lockfile,
    /// so a flag forbidding that has no meaning here.
    fn rewrite_lock(
        dir: String,
        markers: List<Root>,
        before: List<(String, String)>,
    ) -> Bool with IO {
        if same_resolution(markers, before) {
            false
        } else {
            persist_git_lock(dir, markers)
        }
    }

    /// One `Change` per dependency that moved.
    fn changes(markers: List<Root>, before: List<(String, String)>) -> List<Change> {
        List.filter(List.map(markers, \m -> change_of(m, before)), moved)
    }

    fn change_of(marker: Root, before: List<(String, String)>) -> Change {
        Change {
            package: root_package(marker),
            before: lookup(before, root_package(marker)),
            after: marker_commit(marker),
        }
    }

    fn moved(c: Change) -> Bool {
        match change_before(c) {
            None -> true,
            Some(commit) -> commit != change_after(c),
        }
    }

    fn read_project_manifest(dir: String) -> Manifest with IO, Fail {
        let manifest_path = Path.join(dir, "flux.toml")
        match Fs.read_file(manifest_path) {
            Err(_) -> Fail.abort("cannot read " + manifest_path, empty_manifest()),
            Ok(text) -> parse_project_manifest(text, manifest_path),
        }
    }

    fn parse_project_manifest(text: String, manifest_path: String) -> Manifest with IO, Fail {
        match Manifest.parse(text) {
            Err(_) -> Fail.abort("cannot parse " + manifest_path, empty_manifest()),
            Ok(manifest) -> manifest,
        }
    }

    /// Unreachable placeholder for the aborting branches above.
    fn empty_manifest() -> Manifest {
        Manifest {
            package: Package {
                name: "",
                version: "",
                edition: "",
                namespace: "",
            },
            deps: [],
            lib: None,
            bins: [],
        }
    }

    fn render(roots: List<Root>) -> String {
        roots
            |> List.map(render_root)
            |> List.to_array
            |> String.join("\n")
    }

    fn render_root(r: Root) -> String {
        "ok\t" + root_package(r) + "\t" + root_namespace(r) + "\t" + root_dir(r)
    }

    /// Print the resolved roots for the project directory given as the first
    /// argument, or `.` when none is supplied.
    public fn main() with IO {
        let args = Env.args()
        report(
            resolve_with(
                project_dir(args),
                has_flag(args, "--offline"),
                has_flag(args, "--locked"),
            ),
        )
    }

    /// Whether `flag` appears in the argument vector.
    ///
    /// `--frozen` is expanded by the caller into both flags rather than being
    /// a third state here, so this module never has to reason about one flag
    /// implying another.
    fn has_flag(args: Array<String>, flag: String) -> Bool {
        List.contains(Array.to_list(args), flag)
    }

    /// The project directory: the first argument, or the working directory.
    fn project_dir(args: Array<String>) -> String {
        first_non_flag(Array.to_list(args), 0)
    }

    /// The first argument that is not a flag, skipping the program name.
    fn first_non_flag(args: List<String>, index: Int) -> String {
        match args {
            [] -> ".",
            [head | rest] -> if index == 0 || String.starts_with(head, "--") {
                first_non_flag(rest, index + 1)
            } else {
                head
            },
        }
    }

    fn report(resolved: Result<List<Root>, String>) with IO {
        match resolved {
            Err(message) -> print("err\t" + message),
            Ok(roots) -> print(render(roots)),
        }
    }
}
