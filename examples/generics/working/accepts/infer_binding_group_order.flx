// parity-expected-stdout-begin
// 42
// parity-expected-stdout-end

// Binding groups are emitted in dependency order, not source order — Track R1.
//
// `first` is written before `second` but calls it. Emission used to follow
// source position, so the nested `first` closed over `second`'s uninitialised
// slot and the program died with
// `E1001: Not A Function — Cannot call non-function value (got Uninit)`.
// Grouping by reference rather than adjacency is what fixed it (KI-087).

fn main() with IO {
    fn first() { second() + 1 }

    fn second() { 41 }

    print(first())
}
