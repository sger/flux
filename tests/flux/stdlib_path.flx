// Tests for Flow.Path (proposal 0178, stage 0).
//
// Flow.Path is pure string manipulation: no filesystem access, no effects.
// Every assertion here is about the *shape* of a path, never about what
// exists on disk, so these tests are hermetic.

import Flow.Path as Path

// ── classification ─────────────────────────────────────────────

fn test_is_absolute() {
    assert_true(Path.is_absolute("/a/b"))
    assert_true(Path.is_absolute("/"))
    assert_false(Path.is_absolute("a/b"))
    assert_false(Path.is_absolute(""))
    assert_false(Path.is_absolute("./a"))
}

fn test_is_relative_is_the_complement_of_is_absolute() {
    assert_true(Path.is_relative("a/b"))
    assert_true(Path.is_relative(""))
    assert_false(Path.is_relative("/a"))
}

// ── components ─────────────────────────────────────────────────

fn test_components_discards_separators() {
    assert_eq(Path.components("a/b/c"), [|"a", "b", "c"|])
    assert_eq(Path.components("/a/b"), [|"a", "b"|])
}

fn test_components_collapses_empties() {
    // Repeated, leading, and trailing separators all vanish.
    assert_eq(Path.components("/a//b/"), [|"a", "b"|])
    assert_eq(Path.components("///"), [||])
    assert_eq(Path.components(""), [||])
}

// ── join ───────────────────────────────────────────────────────

fn test_join_basic() {
    assert_eq(Path.join("a", "b"), "a/b")
    assert_eq(Path.join("a/b", "c"), "a/b/c")
}

fn test_join_normalizes_the_seam() {
    // Exactly one separator regardless of how the inputs are punctuated.
    assert_eq(Path.join("a/", "b"), "a/b")
    assert_eq(Path.join("a", "/b/c"), "/b/c")
    assert_eq(Path.join("a/", "/b"), "/b")
}

fn test_join_absolute_right_replaces_left() {
    assert_eq(Path.join("a/b", "/etc"), "/etc")
    assert_eq(Path.join("/usr", "/etc"), "/etc")
}

fn test_join_ignores_empty_segments() {
    assert_eq(Path.join("", "b"), "b")
    assert_eq(Path.join("a", ""), "a")
    assert_eq(Path.join("", ""), "")
}

fn test_join_all() {
    assert_eq(Path.join_all([|"a", "b", "c"|]), "a/b/c")
    assert_eq(Path.join_all([||]), "")
    assert_eq(Path.join_all([|"a", "", "c"|]), "a/c")
    // An absolute segment resets the accumulation.
    assert_eq(Path.join_all([|"a", "/b", "c"|]), "/b/c")
}

// ── file_name / parent ─────────────────────────────────────────

fn test_file_name() {
    assert_eq(Path.file_name("a/b.txt"), "b.txt")
    assert_eq(Path.file_name("b.txt"), "b.txt")
    assert_eq(Path.file_name("/a/b"), "b")
    // Trailing separators do not create an empty final component.
    assert_eq(Path.file_name("a/b/"), "b")
}

fn test_file_name_of_rootish_paths_is_empty() {
    assert_eq(Path.file_name("/"), "")
    assert_eq(Path.file_name(""), "")
}

fn test_parent() {
    assert_eq(Path.parent("a/b/c"), "a/b")
    assert_eq(Path.parent("/a/b"), "/a")
    assert_eq(Path.parent("/a"), "/")
}

fn test_parent_never_escapes_its_input() {
    // A lone relative component has no parent to name, and the root is its
    // own parent — neither case may walk above where it started.
    assert_eq(Path.parent("a"), "")
    assert_eq(Path.parent("/"), "/")
    assert_eq(Path.parent(""), "")
}

// ── extension / stem ───────────────────────────────────────────

fn test_extension() {
    assert_eq(Path.extension("a/b.txt"), "txt")
    assert_eq(Path.extension("main.flx"), "flx")
    // Only the last extension counts.
    assert_eq(Path.extension("a/b.tar.gz"), "gz")
}

fn test_extension_absent() {
    assert_eq(Path.extension("a/b"), "")
    assert_eq(Path.extension(""), "")
    assert_eq(Path.extension("a/b."), "")
}

fn test_leading_dot_is_hidden_not_an_extension() {
    // `.flxrc` is a hidden file with no extension, not an extension `flxrc`.
    assert_eq(Path.extension(".flxrc"), "")
    assert_eq(Path.file_stem(".flxrc"), ".flxrc")
}

fn test_file_stem() {
    assert_eq(Path.file_stem("a/b.txt"), "b")
    assert_eq(Path.file_stem("a/b.tar.gz"), "b.tar")
    assert_eq(Path.file_stem("a/b"), "b")
    assert_eq(Path.file_stem(""), "")
}

fn test_with_extension() {
    assert_eq(Path.with_extension("src/main.flx", "flxi"), "src/main.flxi")
    // Adds one when absent, removes one when given "".
    assert_eq(Path.with_extension("src/main", "flx"), "src/main.flx")
    assert_eq(Path.with_extension("src/main.flx", ""), "src/main")
    assert_eq(Path.with_extension("main.flx", "flxi"), "main.flxi")
}

// ── normalize ──────────────────────────────────────────────────

fn test_normalize_resolves_dot() {
    assert_eq(Path.normalize("a/./b"), "a/b")
    assert_eq(Path.normalize("./a"), "a")
    assert_eq(Path.normalize("a/."), "a")
}

fn test_normalize_resolves_dotdot() {
    assert_eq(Path.normalize("a/b/../c"), "a/c")
    assert_eq(Path.normalize("a/.."), ".")
    assert_eq(Path.normalize("/a/b/../c"), "/a/c")
}

fn test_normalize_collapses_separators() {
    assert_eq(Path.normalize("a//b"), "a/b")
    assert_eq(Path.normalize("a/b/"), "a/b")
    assert_eq(Path.normalize("/a//b/"), "/a/b")
}

fn test_normalize_dotdot_at_an_absolute_root_is_absorbed() {
    // `/..` is `/`, so the escape is discarded rather than preserved.
    assert_eq(Path.normalize("/.."), "/")
    assert_eq(Path.normalize("/../a"), "/a")
}

fn test_normalize_preserves_escaping_dotdot_when_relative() {
    // `../a` is meaningful relative to an unknown working directory, so it
    // must survive normalization.
    assert_eq(Path.normalize("../a"), "../a")
    assert_eq(Path.normalize("a/../../b"), "../b")
    assert_eq(Path.normalize("../.."), "../..")
}

fn test_normalize_is_idempotent() {
    // Normalizing an already-normal path changes nothing — the property that
    // makes it safe to normalize defensively.
    assert_eq(Path.normalize(Path.normalize("a/./b/../c")), Path.normalize("a/./b/../c"))
    assert_eq(Path.normalize(Path.normalize("/../x//y")), Path.normalize("/../x//y"))
    assert_eq(Path.normalize(Path.normalize("../a/..")), Path.normalize("../a/.."))
}

fn test_normalize_of_empty_is_current_directory() {
    assert_eq(Path.normalize(""), ".")
    assert_eq(Path.normalize("."), ".")
    assert_eq(Path.normalize("/"), "/")
}

// ── round-trip properties ──────────────────────────────────────

fn test_parent_and_file_name_reconstruct_the_path() {
    assert_eq(Path.join(Path.parent("a/b/c"), Path.file_name("a/b/c")), "a/b/c")
    assert_eq(Path.join(Path.parent("/a/b"), Path.file_name("/a/b")), "/a/b")
    assert_eq(Path.join(Path.parent("a"), Path.file_name("a")), "a")
}

fn test_stem_and_extension_reconstruct_the_file_name() {
    assert_eq(Path.file_stem("b.tar.gz") + "." + Path.extension("b.tar.gz"), "b.tar.gz")
    assert_eq(Path.file_stem("main.flx") + "." + Path.extension("main.flx"), "main.flx")
}

fn test_separator() {
    assert_eq(Path.separator(), "/")
}
